метод Скрипт()
    пер РабочаяПапка = "K:\\1С-ЭЛЕМЕНТ\\Ерофеев\\33"
    
    // исп ПотокЗаписи = новый Файл("$РабочаяПапка\\партнеры.xml").ОткрытьПотокЗаписи()
    // ЗаписьДанныхВXML(ПотокЗаписи)
    
    // исп ПотокЧтения = новый Файл("$РабочаяПапка\\партнеры.xml").ОткрытьПотокЧтения()
    // ЧтениеДанныхИзXML(ПотокЧтения)
    
    
    
    //Задание 1
    исп ПотокЗаписиТелефонногоСправоника = новый Файл("$РабочаяПапка\\phonebook.xml").ОткрытьПотокЗаписи()
    знч ЗаписьТелефонногоСправочника = новый  ЗаписьXml(ПотокЗаписиТелефонногоСправоника)
    ЗаписьТелефонногоСправочника.ЗаписатьНачалоДокумента()
        .ЗаписатьНачалоЭлемента("ТелефоннаяКнига")
            .ЗаписатьНачалоЭлемента("Контакт")
                .ЗаписатьНачалоЭлемента("Имя").ЗаписатьТекст("Анна").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Номер").ЗаписатьТекст("555-1234").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Город").ЗаписатьТекст("Москва").ЗаписатьКонецЭлемента()
            .ЗаписатьКонецЭлемента()
            .ЗаписатьНачалоЭлемента("Контакт")
                .ЗаписатьНачалоЭлемента("Имя").ЗаписатьТекст("Анна").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Номер").ЗаписатьТекст("555-1234").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Город").ЗаписатьТекст("Москва").ЗаписатьКонецЭлемента()
            .ЗаписатьКонецЭлемента()      
        .ЗаписатьКонецЭлемента()
    .ЗаписатьКонецДокумента()
    Консоль.Записать("Файл создан.\н")
    
    //Задание 2
    исп ПотокЧтенияКонтактов = новый Файл("$РабочаяПапка\\contacts.xml").ОткрытьПотокЧтения()
    знч ЧтениеКонтактов = новый ЧтениеXml(ПотокЧтенияКонтактов)
    пока ЧтениеКонтактов.Следующий()
        выбор ЧтениеКонтактов.ВидУзла
        когда НачалоЭлемента
            Консоль.Записать(ЧтениеКонтактов.Имя + ЧтениеКонтактов.Значение)
        когда Текст
            Консоль.Записать("    ${ЧтениеКонтактов.Значение}")
        когда КонецЭлемента
            Консоль.Записать("/")
        ;
    ;
    
    //Задание 3
    исп ПотокЧтенияКонтактов3 = новый Файл("$РабочаяПапка\\contacts.xml").ОткрытьПотокЧтения()
    знч ЧтениеКонтактов3 = новый ЧтениеXml(ПотокЧтенияКонтактов3)
    пер ИмяДляПоиска = Консоль.СчитатьСтроку("Введите имя для поиска")
    пока ЧтениеКонтактов3.Следующий()
        выбор ЧтениеКонтактов3.ВидУзла
        когда НачалоЭлемента
            // Консоль.Записать(ЧтениеКонтактов3.Имя + ЧтениеКонтактов3.Значение)
        когда Текст
            // Консоль.Записать("    ${ЧтениеКонтактов.Значение}")
            если ЧтениеКонтактов3.Значение == ИмяДляПоиска
                Консоль.Записать("Имя есть.")
            ;
        когда КонецЭлемента
            
        ;
    ;
    
    /*Задача: Напишите программу, которая запрашивает у пользователя имя (например, 
«Мария Сидорова») и ищет его в файле contacts.xml. Если найдено, вывести телефон и email. 
Если нет – сообщить «Контакт не найден». Используйте потоковое чтение.
*/
;



метод ЧтениеДанныхИзXML(ПотокЧтения: ПотокЧтения)
    знч Чтение = новый ЧтениеXml(ПотокЧтения)
    пер Отступ = ""
    пер Первый = Истина
    пока Чтение.Следующий()
        выбор Чтение.ВидУзла
        когда НачалоЭлемента
            если Первый
                Первый = Ложь
            иначе
                Отступ += "    "   
            ;
            Консоль.Записать(Отступ + Чтение.Имя)
            для Индекс = 0 по Чтение.КоличествоАтрибутов() - 1
                пер ИмяАтрибута = Чтение.ИмяАтрибута(Индекс)
                Консоль.Записать(
                    "$Отступ    Атрибут: $ИмяАтрибута = ${Чтение.ЗначениеАтрибута(ИмяАтрибута)}"
                )
            ;
        когда Текст
            Консоль.Записать("$Отступ    ${Чтение.Значение}")
        когда КонецЭлемента
            если Отступ.Длина() >= 3
                Отступ = Отступ.ПодстрокаСНачала(Отступ.Длина() - 4)
            ;
        ;
    ;
;
метод ЗаписьДанныхВXML(ПотокЗаписи: ПотокЗаписи)
    знч Запись = новый ЗаписьXml(ПотокЗаписи)
    
    Запись.ЗаписатьНачалоДокумента()
        .ЗаписатьНачалоЭлемента("Партнёр")
            .ЗаписатьНачалоЭлемента("Код").ЗаписатьТекст("00000000017").ЗаписатьКонецЭлемента()
            .ЗаписатьНачалоЭлемента("Наименование").ЗаписатьТекст("ОАС Топаз").ЗаписатьКонецЭлемента()
            .ЗаписатьНачалоЭлемента("Телефоны")
                .ЗаписатьНачалоЭлемента("Телефон").ЗаписатьТекст("89113456789").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Телефон").ЗаписатьТекст("89113456789").ЗаписатьКонецЭлемента()
            .ЗаписатьКонецЭлемента()
            .ЗаписатьНачалоЭлемента("ОбъемПродаж").ЗаписатьТекст("5000000").ЗаписатьКонецЭлемента()
            .ЗаписатьНачалоЭлемента("ЭтоПоставщик").ЗаписатьТекст("false").ЗаписатьКонецЭлемента()
            .ЗаписатьНачалоЭлемента("xref")
                .ЗаписатьАтрибут("href", "t00020.txt").ЗаписатьАтрибут("id", "u2z_1gs")
                .ЗаписатьТекст("КонтактнаяИнформация")
            .ЗаписатьКонецЭлемента()
        .ЗаписатьКонецЭлемента()    
    .ЗаписатьКонецДокумента()
;
