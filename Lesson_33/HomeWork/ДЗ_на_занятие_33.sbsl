//ДЗ на занятие №33.
//Автор:
// ======= Ерофеев Игорь =======

//№10
структура Книга
    обз пер Название: Строка
    пер Автор: Строка
    пер Год: Число
;

метод Скрипт()
    пер МестоКаталогаДляПроверки = ПутьКРабочейПапке()
    СозданиеОбъектов(МестоКаталогаДляПроверки)
    

    //Задание 1
    исп ПотокЗаписи1 = новый Файл(МестоКаталогаДляПроверки + "Задание 1/card.json").ОткрытьПотокЗаписи()
    знч Запись1 = новый ЗаписьJson(ПотокЗаписи1)
    Запись1.ЗаписатьНачалоМассива()
        .ЗаписатьНачалоОбъекта()
            .Записать("Имя", "Игорь")
            .Записать("Возраст", 17)
            .Записать("Хобби", "Программирование")
        .ЗаписатьКонецОбъекта()
    .ЗаписатьКонецМассива()
    
    исп ПотокЧтения1 = новый Файл(МестоКаталогаДляПроверки + "Задание 1/card.json").ОткрытьПотокЧтения()
    пер Сотрудники = СериализацияJson.ПрочитатьМассив(ПотокЧтения1)
    Консоль.Записать("Задание 1.\н$Сотрудники\н")

    
    
    
    //Задание 2
    исп ПотокЗаписи2 = новый Файл(МестоКаталогаДляПроверки + "Задание 2/shopping.json").ОткрытьПотокЗаписи()
    знч Запись2 = новый ЗаписьJson(ПотокЗаписи2)
    Запись2.ЗаписатьНачалоМассива()
        .ЗаписатьНачалоМассива()
            .Записать("Хлеб")
            .Записать("Молоко")
            .Записать("Яблоки")
            .Записать("Печенье")
        .ЗаписатьКонецМассива()
    .ЗаписатьКонецМассива()
    
    исп ПотокЧтения2 = новый Файл(МестоКаталогаДляПроверки + "Задание 2/shopping.json").ОткрытьПотокЧтения()
    пер Продукты = СериализацияJson.ПрочитатьМассив(ПотокЧтения2)
    Консоль.Записать("Задание 2.\н$Продукты\н")
    
    
    
    //Задание 3
    Консоль.Записать("Задание 3.")
    исп ПотокЧтения3 = новый Файл(МестоКаталогаДляПроверки + "Задание 3/schedule.json").ОткрытьПотокЧтения()
    пер ДниНедели = СериализацияJson.ПрочитатьСоответствие(ПотокЧтения3)
    для ДеньНедели из ДниНедели
        Консоль.Записать("В ${ДеньНедели.Ключ} - ${ДеньНедели.Значение}")
    ;
    
    
    
    //Задание 4
    пер Оценки = [5, 4, 5, 3, 4]
    пер JSONСтрокаОценок = СериализацияJson.ЗаписатьОбъект(Оценки)
    пер МассивОценок = СериализацияJson.ПрочитатьМассив(JSONСтрокаОценок)
    пер СуммаОценок: Число
    для Оценка из Оценки
        СуммаОценок += Оценка
    ;
    Консоль.Записать("\нЗадание 4.\н$JSONСтрокаОценок\нСумма оценок: $СуммаОценок\н")
    
    
    
    //Задание 5
    исп ПотокЗаписи5 = новый Файл(МестоКаталогаДляПроверки + "Задание 5/settings.json").ОткрытьПотокЗаписи()
    знч Запись3 = новый ЗаписьJson(ПотокЗаписи5)
    Запись3.ЗаписатьНачалоОбъекта()
        .Записать("ТемнаяТема", Истина)
        .Записать("УровеньГромкости", 50)
        .Записать("ИмяПользователя", "Игорь")
    .ЗаписатьКонецОбъекта()
    
    исп ПотокЧтения5 = новый Файл(МестоКаталогаДляПроверки + "Задание 5/settings.json").ОткрытьПотокЧтения()
    пер Настройки = СериализацияJson.ПрочитатьСоответствие(ПотокЧтения5)
    Консоль.Записать("Задание 5.\нУровень громкости: ${Настройки.Получить("УровеньГромкости")}\н")
    
    
    
    //Задание 6
    исп ПотокЧтения6 = новый Файл(МестоКаталогаДляПроверки + "Задание 6/group.json").ОткрытьПотокЧтения()
    пер Студенты = СериализацияJson.ПрочитатьМассив(ПотокЧтения6)
    
    пер НовыйСтудент = новый Соответствие<Строка, Объект?>()
    НовыйСтудент.Вставить("Фамилия", "Сидоров")
    НовыйСтудент.Вставить("Имя", "Николай")
    Студенты.Добавить(НовыйСтудент)
    
    исп ПотокЗаписи6 = новый Файл(МестоКаталогаДляПроверки + "Задание 6/group.json").ОткрытьПотокЗаписи()
    СериализацияJson.ЗаписатьОбъект(ПотокЗаписи6, Студенты)
    Консоль.Записать("Задание 6.\нСтудент записан.\н")


    
    //Задание 7
    исп ПотокЗаписи7 = новый Файл(МестоКаталогаДляПроверки + "Задание 7/Ex7.json").ОткрытьПотокЗаписи()
    пер Настройки7 = новый НастройкиЗаписиJson()
    Настройки7.ПереносСтрок = ПереносСтрокJson.Отсутствует
    пер Запись7 = новый ЗаписьJson(ПотокЗаписи7, Настройки7)
    Запись7.ЗаписатьНачалоМассива()
        .ЗаписатьНачалоОбъекта()
            .Записать("Товар", "Ноутбук")
            .Записать("Цена", 50000)
            .Записать("Вналичии", Истина)
        .ЗаписатьКонецОбъекта()
    .ЗаписатьКонецМассива()
    
    исп ПотокЧтения7 = новый Файл(МестоКаталогаДляПроверки + "Задание 7/Ex7.json").ОткрытьПотокЧтения()
    пер Поля = СериализацияJson.ПрочитатьОбъект(ПотокЧтения7)
    Консоль.Записать("Задание 7.\н$Поля\н")
    
    
    
    
    //Задание 8
    исп ПотокЧтения8 = новый Файл(МестоКаталогаДляПроверки + "Задание 8/score.json").ОткрытьПотокЧтения()
    пер Игроки = СериализацияJson.ПрочитатьМассив(ПотокЧтения8)
    пер МаксОчки: Число
    пер НикИгрокаСМаксимальнымиОчками: Строка
    для ИгрокИз из Игроки
        пер Игрок = ИгрокИз как Соответствие<Строка, Объект?>
        НикИгрокаСМаксимальнымиОчками = Игрок.Получить("Ник").ВСтроку()
        пер Очки = Игрок.Получить("Очки")
        пер ОчкиВЧисле = новый Число(Очки.ВСтроку())
        если ОчкиВЧисле > МаксОчки
            МаксОчки = ОчкиВЧисле
        ;
    ;
    Консоль.Записать("Задание 8.\нИгрок с максимальным количеством очков:\н$НикИгрокаСМаксимальнымиОчками - $МаксОчки очков\н")

    //Задание 9
    Консоль.Записать("Задание 9.")
    попытка
        исп ПотокЗаписи9 = новый Файл(МестоКаталогаДляПроверки + "Задание 9/bad.json").ОткрытьПотокЗаписи()
        знч Запись9 = новый ЗаписьJson(ПотокЗаписи9)
        Запись9.ЗаписатьНачалоМассива()
            .Записать(42)
        ПотокЗаписи9.Закрыть()
        пер JsonСтрока = ПотокЗаписи9.ВСтроку()
    поймать ОшибкаJson: ИсключениеЗаписиJson
        Консоль.Записать("Ошибка структуры JSON")
    ;
    исп ПотокЗаписи9 = новый СтроковыйПотокЗаписи()
    знч Запись9 = новый ЗаписьJson(ПотокЗаписи9)
    Запись9.ЗаписатьНачалоМассива()
        .Записать(42)
    .ЗаписатьКонецМассива()
    пер JsonСтрока9 = ПотокЗаписи9.ВСтроку()
    Консоль.Записать(JsonСтрока9)

    
    
    //Задание 10
    пер Книги = [ //У одной год поменял, чтобы что-то выводило
        новый Книга("Преступление и наказание", "Фёдор Михайлович Достоевский", 1866),
        новый Книга("Гарри Поттер и философский камень", "Джоан Роулинг", 2999),
        новый Книга("Мастер и Маргарита", "Михаил Афанасьевич Булгаков", 1967)
    ]

    // Запись в файл
    исп ПотокЗаписи10 = новый Файл(МестоКаталогаДляПроверки + "Задание 10/books.json").ОткрытьПотокЗаписи()
    СериализацияJson.ЗаписатьОбъект(ПотокЗаписи10, Книги)

    исп ПотокЧтения10 = новый Файл(МестоКаталогаДляПроверки + "Задание 10/books.json").ОткрытьПотокЧтения()
    пер ПрочитанныеКниги = СериализацияJson.ПрочитатьМассив(ПотокЧтения10)

    Консоль.Записать("\нЗадание 10.\нКниги, изданные после 2000 года:")
    для КнигаИз из ПрочитанныеКниги
        пер Книга = КнигаИз как Соответствие<Строка, Объект?>
        пер Год = Книга.Получить("Год")
        пер ГодВЦифре = новый Число(Год.ВСтроку())
        если ГодВЦифре > 2000
            Консоль.Записать("${Книга.Получить("Название")} - ${Книга.Получить("Автор")} (${Год})")
        ;
    ;
;
    
    



метод ПутьКРабочейПапке(): Строка
    пер ВыборЗаписи = Консоль.СчитатьЧисло("Введите число для создания каталога с нужными файлами с клавиатуры:\н1 - ввести путь \н2 - использовать автоматический путь.\н > ")
    пер МестоКаталогаДляПроверки = "/"
    
    если ВыборЗаписи == 1
        МестоКаталогаДляПроверки = Консоль.СчитатьСтроку("Введите путь: ")
    иначе
        МестоКаталогаДляПроверки = "/home/${СредаИсполнения.ПолучитьПеременную("USER")}/Документы/1С.Занятие 33/"
        если СредаИсполнения.ПолучитьСвойство("os.name").Найти("Windows") != -1
            МестоКаталогаДляПроверки = "D:\\1С.Занятие 33\\"
        ;
    ;
    
    для НомерКаталога = 1 по 10
        выбор НомерКаталога
        когда != 4, 7, 9
            Файлы.СоздатьКаталог(МестоКаталогаДляПроверки + "Задание $НомерКаталога")
        ;
    ;
    
    возврат МестоКаталогаДляПроверки
;

метод СозданиеОбъектов(МестоКаталогаДляПроверки: Строка)
    
    для НомерКаталога = 1 по 10
        выбор НомерКаталога
        когда != 4, 7, 9
            Файлы.СоздатьКаталог(МестоКаталогаДляПроверки + "Задание $НомерКаталога")
        ;
    ;
    
    исп ПотокЗаписи03 = новый Файл(МестоКаталогаДляПроверки + "Задание 3/schedule.json").ОткрытьПотокЗаписи()
    знч Запись03 = новый ЗаписьJson(ПотокЗаписи03)
    Запись03.ЗаписатьНачалоОбъекта()
        .Записать("Понедельник", "Математика")
        .Записать("Вторник", "Физика")
        .Записать("Среда", "Литература")
        .Записать("Четверг", "История")
        .Записать("Пятница", "Информатика")
    .ЗаписатьКонецОбъекта()
    
    исп ПотокЗаписи06 = новый Файл(МестоКаталогаДляПроверки + "Задание 6/group.json").ОткрытьПотокЗаписи()
    знч Запись06 = новый ЗаписьJson(ПотокЗаписи06)
    Запись06.ЗаписатьНачалоМассива()
        .ЗаписатьНачалоОбъекта()
            .Записать("Фамилия", "Иванов")
            .Записать("Имя", "Петр")
        .ЗаписатьКонецОбъекта()
        .ЗаписатьНачалоОбъекта()
            .Записать("Фамилия", "Петрова")
            .Записать("Имя", "Анна")
        .ЗаписатьКонецОбъекта()
    .ЗаписатьКонецМассива()
    
    исп ПотокЗаписи08 = новый Файл(МестоКаталогаДляПроверки + "Задание 8/score.json").ОткрытьПотокЗаписи()
    знч Запись08 = новый ЗаписьJson(ПотокЗаписи08)
    Запись08.ЗаписатьНачалоМассива()
        .ЗаписатьНачалоОбъекта()
            .Записать("Ник", "Мастер")
            .Записать("Очки", 1200)
        .ЗаписатьКонецОбъекта()
        .ЗаписатьНачалоОбъекта()
            .Записать("Ник", "Новичок")
            .Записать("Очки", 450)
        .ЗаписатьКонецОбъекта()
        .ЗаписатьНачалоОбъекта()
            .Записать("Ник", "Лидер")
            .Записать("Очки", 2000)
        .ЗаписатьКонецОбъекта()
    .ЗаписатьКонецМассива()
    Консоль.Записать("Нужные каталоги успешно созданы по адресу \"$МестоКаталогаДляПроверки\".\н\н")
;