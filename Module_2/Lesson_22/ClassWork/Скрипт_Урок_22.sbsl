//==================
//== Соответствие ==
//==================

метод Соответствие1()
    пер КраткийЛитерал = {"Длина": 180, "Ширина": 90, "Высота": 20}
    пер ЛитералСТипом = <Строка, Число|Строка> {"Длина": 180, "Ширина": 90, "Высота": 20}
    пер ПустоеСоответствие = <Строка, Число> {:}
    пер СКонструктором = новый Соответствие<Строка, Булево>()   
;

метод ПримерСотв()
    пер Урок = {"Название": "Математика", "НомерКабинета": 311, "Начало": ДатаВремя{2026-04-11 13:00:00}}   
    пер НачалоЗанятий = Урок["Начало"]
    пер ЗначениеПредмета = Урок["Название"]
;

метод ПримерМетода()
    пер Урок = {"Название": "Математика", "НомерКабинета": 311, "Начало": ДатаВремя{2026-04-11 13:00:00}}   
    Урок.Вставить("Учитель", "Сергеев")
    Урок.Вставить("Название", "Физика")
    Урок.ВставитьЕслиОтсутствует("Название", "Литература")
    // пер Лаборант = Урок["Лаборант"]
    // Консоль.Записать(Лаборант)
    
    пер Лаборант = Урок.ПолучитьИлиНеопределено("Лаборант")
    если Лаборант == Неопределено
        Консоль.Записать("Такого элемента нет.")
    ;
    
    пер Компьютеры = Урок.ПолучитьИлиУмолчание("Компьютеры", "Ошибка")
    Консоль.Записать(Компьютеры)
    
;

метод Книга()
    пер Книга = {"Название":"Война и мир", "Автор":"Толстой", "Год":1869}  
    Консоль.Записать(Книга["Автор"])
;

метод Расписание()
    пер Расписание = {"Понедельник":"Физ-ра", "Вторник":"Математика"}   
    Расписание.Вставить("Среда", "Химия")
    Расписание.ВставитьЕслиОтсутствует("Вторник", "История")
    Консоль.Записать(Расписание)
;


//==============
//== Множесто ==
//==============

метод Множество()
    пер КраткийЛитерал = {1, 2, 6, 8}
    пер ЛитералСТипом = <Число|Строка>{1, "Стол", 375}
    пер Конструктор = новый Множество<Строка>()
    пер ПустоеМножество = <Число>{}
;

метод МетодыМножества()
    пер Числа = {3, 87, 49, 6, 293}
    Числа.Добавить(13)
    Числа.Добавить(6)  
    Числа.Удалить(87)
    
    пер Числа2 = {10, 54, 32}
    Числа.ДобавитьВсе(Числа2)
    
    пер Числа3 = {10, 73, 123}
    пер Объединение = Числа2.Объединение(Числа3)
    пер Пересечение = Числа2.Пересечение(Числа3)
    пер Разность = Числа2.Разность(Числа3)
    
    
;

метод Фрукты()
    пер ЛюбимыеФрукты = {"Яблоко", "Банан", "Апельсин"}
    пер ФруктыДруга = {"Банан", "Киви", "Манго", "Ананас"}
    пер Разность = ФруктыДруга.Разность(ЛюбимыеФрукты) // ==> {Киви, Манго, Ананас}
    Консоль.Записать(Разность)
;

метод Одноклассники()
    пер СекцияБаскетбол = {"Иванов", "Петров", "Сидоров", "Козлов"}
    пер СекцияФутбол = {"Петров", "Смирнов", "Козлов", "Васильев"}
    пер Спортсмены = СекцияБаскетбол.Объединение(СекцияФутбол)
    пер Мультиспортсмены = СекцияБаскетбол.Пересечение(СекцияФутбол)
    Консоль.Записать(Спортсмены)
    Консоль.Записать(Мультиспортсмены)
;

метод Уникальность()
    пер Набор = ["а", "е", "а", "щ", "е", "о", "а"]
    пер Множество = <Строка>{}
    Консоль.Записать(Набор)
    // Консоль.Записать(Набор.Уникальные().Размер())
    // Консоль.Записать(Набор.ВоМножество().Размер())
    для Элемент из Набор
        Множество.Добавить(Элемент)
    ;
    Консоль.Записать("Уникальные: $Множество")
    Консоль.Записать(Множество.Размер())
;

метод Цвета()
    пер НаборЦветов = {"Красный", "Синий", "Желтый", "Фиолетовый"} 
    Консоль.Записать(НаборЦветов)  
    для Элемент из НаборЦветов
        Консоль.Записать(Элемент)
    ;
;

метод Арифметика()
    пер Четные = {2, 4, 6, 8, 10}
    пер Нечетные = {1, 3, 5, 7, 9}
    пер Объединение = Четные.Объединение(Нечетные)
    пер Пересечение = Четные.Пересечение(Нечетные)
    пер Разность = Четные.Разность(Нечетные)
    Консоль.Записать("$Объединение\н$Пересечение\н$Разность")
    
;
