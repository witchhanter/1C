метод Скрипт()
    пер Длина = 8165.27
    знч Цвет = 0xFF0000 //шестнадцатиричная сс, в данном случае - цвет
    знч Маска = 0b10000111 //двоичная сс
    
    пер МоеЧисло1 = новый Число("123")
    пер МоеЧисло2 = новый Число("+1.23")
    пер МоеЧисло3 = новый Число("-12.3")
    
    //методы чисел
    Длина = 8165.27
    пер Километры = (Длина/1000).ЦелаяЧасть() //отбросить дробную часть
    
    пер Сумма = 250000.535
    Консоль.Записать(Сумма.Представление()) //-> 250 000,535
    
    Консоль.Записать(Сумма.Представление("_.2")) //Представление числа в финансовом виде, округление по правилам математики
    //"_" -  флаг, который указывает, что целая часть будет сгруппирована по три разряда, группы разрядов по умолчанию будут разделены неразрывным пробелом
    //".2" - кво символов после точки
    
    Консоль.Записать(Сумма.Представление("_; РГ=,; РД=.;")) //"РГ" без флага "_" не работает
    //"РГ" - разделитель разрядов
    //"РД" - разделитель целой и дробной части
    
    Сумма = 123
    Консоль.Записать(Сумма.Представление("05")) //0 - символ для дополнения ква символов, по умолчанию пробел; 5 - кво элементов в числе  //-> 00123

    Консоль.Записать(Сумма.Представление("+")) // -> +123

    пер ДоляВПроцентах = 53.53
    Консоль.Записать(ДоляВПроцентах.Представление(".1; ОК=ПВВ")) //ОК - округление; ПВВ - половина вверх; 
    Консоль.Записать(ДоляВПроцентах.Представление(".1; ОК=ПВН")) //ПВН - половина вниз
    Консоль.Записать(ДоляВПроцентах.Представление(".1; ОК=ВВ")) //Вверх, строго
    Консоль.Записать(ДоляВПроцентах.Представление(".1; ОК=ВН")) //Вниз, строго


    пер ОкруглениеДолиВниз = ДоляВПроцентах.Округлить(1, РежимОкругления.Вниз) // 1  -кво знаков после запятой
    пер ОкруглениеДолиВверх = ДоляВПроцентах.Округлить(2, РежимОкругления.Вверх)
    пер ОкруглениеДолиМатематики = ДоляВПроцентах.Округлить(1, РежимОкругления.ПоловинаВверх)
    
    Сумма = 250000.535
    Консоль.Записать(Сумма.Представление("'€'.2"))
    Консоль.Записать(Сумма.Представление(".2'₽'"))
    Консоль.Записать(Сумма.Представление(".2'$'"))
    Консоль.Записать(Сумма.Представление("Деньги")) // -> 250 000,54
    
    пер Процент = 0.12537
    Консоль.Записать(Процент.Представление("Процент"))
    
    



;