структура Сотрудник
    пер ФИО: Строка
    пер Адрес: ПочтовыйАдрес?
    пер Телефон: Строка? 
;
структура ПочтовыйАдрес
    пер Страна: Строка?
    пер Город: Строка
    пер Улица: Строка
    пер Дом: Строка?
;

//Задание 4.
перечисление Редкость
    Обычный,
    Редкий,
    Легендарный
    
;
структура КосмоТовар
    обз знч Название: Строка
    обз пер Цена: Число
    пер Редкость = Редкость.Обычный
    пер Количество = 1
    
    метод ПрименитьСкидку(Процент: Число, Товар: КосмоТовар)
        Товар.Цена *= (1 - Процент / 100)
    ;
    статический метод ОбщаяСтоимость(Товары: Массив<КосмоТовар>): Число
        пер Сумма: Число
        для Элемент из Товары
            Сумма += Элемент.Цена * Элемент.Количество
        ;
        возврат Сумма
    ;
;

метод Скрипт()
    // Оператор "как"
    пер МояПеременная: Строка | Число | ? //Можно сохранить строку, число или что то другое
    пер МояПеременная2: Строка? // строка или что то другое, | можно не писать для краткости
    пер МояПеременная3: Строка | Число | Булево = "тест" //если так, то нужно задавать какое то значение
    пер ДлинаСтроки = (МояПеременная3 как Строка).Длина() //определить длину строки, операция "как" (не преобразует тип, а выбирает из перечисленных типов при создании)
    
    
    пер Стажер = новый Сотрудник("Иванов", новый ПочтовыйАдрес("Петрозаводск"))
    пер Менеджер = новый Сотрудник("Петров")
    
    //Настойчивая операция ("!") (если выражение не может принять значение "Неопределено")
    пер АдресСотрудника = Стажер.Адрес! //убирает тип "Неопределено" из описания типов
    //Операция «Безопасный доступ» ("?") - выполняется доступ, только если источник вызова не Неопределено, иначе результат всей цепочки становится Неопределено
    //Операция «Умолчание» ("??") -  возвращает значение правого выражения, если значение левого выражения Неопределено
    пер СтранаСотрудника = Менеджер.Адрес?.Страна ?? "Страна неизвестна"
    
    
    //Задание 1.
    пер ЦенаТовара: Число | Строка = "Договорная"
    пер ЦенаДляВывода = (ЦенаТовара как Строка)
    
    //Задача 2.
    пер Результат: Число | Строка = "не явился"
    попытка 
        пер ПроверкаОценки = (Результат как Число)
        Консоль.Записать("Оценка $ПроверкаОценки")
    поймать Искл: Исключение
        Консоль.Записать("Ученик отсутствовал")
    ;
      
    //Задача 3.
    пер Возраст: Число?
    Консоль.Записать(Возраст.Представление())
    Возраст = 15
    Консоль.Записать(Возраст)
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    //Задача 4. «Космический магазин»
    пер КосмоТовары = [
        новый КосмоТовар("Лунный камень", 999, Редкость.Легендарный, 4),
        новый КосмоТовар("Реакторный чип", 599, Редкость.Редкий, 2),
        новый КосмоТовар("Часть метеорита", 299),
        новый КосмоТовар("Двигатель Х", 9999, Редкость.Легендарный, 5),
        новый КосмоТовар("Лунный кристалл", 99999, Редкость.Легендарный)
    ]
    КосмоТовары[0].ПрименитьСкидку(15, КосмоТовары[0])
    КосмоТовары[3].ПрименитьСкидку(15, КосмоТовары[3])
    Консоль.Записать("\н\нЗадача 4.\нОбщая стоимость всех товаров: ${КосмоТовар.ОбщаяСтоимость(КосмоТовары)}")
    
;