    ]
    пер ИндексФевраля = Месяца.Найти("ФевралЬ")
    
    попытка 
        Месяца.Установить(ИндексФевраля, "Второй месяц")
        Консоль.Записать("Успешно.")
    поймать Искл: Исключение
        Консоль.Записать("Февраль потерян.")
    вконце
        Консоль.Записать(Месяца)
