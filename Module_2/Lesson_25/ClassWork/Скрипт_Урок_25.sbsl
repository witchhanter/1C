//Срез по коллекциям


//Задание 4.
перечисление Редкость
    Обычный,
    Редкий,
    Легендарный
    
;
структура КосмоТовар
    обз знч Название: Строка
    обз пер Цена: Число
    пер Редкость = Редкость.Обычный
    пер Количество = 1
    
    метод ПрименитьСкидку(Процент: Число, Товар: КосмоТовар)
        Товар.Цена *= (100 - Процент)
    ;
    статический метод ОбщаяСтоимость(Товары: Массив<КосмоТовар>): Число
        пер Сумма: Число
        для Элемент из Товары
            Сумма += Элемент.Цена * Элемент.Количество
        ;
        возврат Сумма
    ;
;

метод Скрипт()
    //Задание 1.
    пер Оценки = [5, 4, 5, 3, 4]
    Консоль.Записать("Задание 1.\н$Оценки\нОценки: ")
    для Оценка из Оценки
        Консоль.Записать(Оценка)
    ;
    Консоль.Записать("Средний балл: ${Оценки.Среднее()}\н")
    
    
    //Задание 2.
    Оценки = [4, 4, 2, 5, 2]
    Консоль.Записать("Задание 1.\н$Оценки\нОценки: ")
    для Оценка = 0 по Оценки.Граница()
        Консоль.Записать(Оценки[Оценка])
    ;
    Консоль.Записать("Средний балл: ${Оценки.Сумма() / Оценки.Размер()}\н")
    
    
    //Задание 3.
    пер Числа = [11, 3, 17, 8, 16, 7, 13]
    пер КвоЧетных: Число
    для Число из Числа
        если Число % 2 == 0
            КвоЧетных += 1
        ;
    ;
    Консоль.Записать("Задание 3.\н$Числа\нКоличество четных: $КвоЧетных\н")
    
    
    //Задание 4.
    Числа = [2, 7, 4, 9, 12, 5, 8]
    пер КвоНечетных: Число
    для Число из Числа
        если Число % 2 != 0
            КвоНечетных += 1
        ;
    ;
    Консоль.Записать("Задание 4.\н$Числа\нКоличество нечетных: $КвоНечетных\н")
    
    
    //Задание 5.
    Числа = [3, 2, 14, 4, 7, 4, 16]
    пер СуммаЧетных: Число
    для Число из Числа
        если Число % 2 == 0
            СуммаЧетных += Число
        ;
    ;
    Консоль.Записать("Задание 5.\н$Числа\нСумма четных чисел: $СуммаЧетных\н")
   
   
    //Задание 6.
    пер Ученики = ["Коля", "Оля", "Маша", "Оля", "Оля", "Иван"]
    пер Вхождение = новый  Соответствие<Строка, Число>()
    для Ученик из Ученики
        если Вхождение.СодержитКлюч(Ученик)
            Вхождение.Вставить(Ученик, Вхождение.Получить(Ученик) + 1)
        иначе
            Вхождение.Вставить(Ученик, 1)
        ;
    ;
    Консоль.Записать("Задание 6.\н$Ученики\нКоличество вхождений: $Вхождение\н")
    
    
    //Задание 7.
    Ученики = ["Аня", "Петя", "Маша", "Игорь", "Аня"]
    Вхождение = новый  Соответствие<Строка, Число>()
    для Ученик из Ученики
        если Вхождение.СодержитКлюч(Ученик)
            Вхождение.Вставить(Ученик, Вхождение.Получить(Ученик) + 1)
        иначе
            Вхождение.Вставить(Ученик, 1)
        ;
    ;
    Консоль.Записать("Задание 7.\н$Ученики\нКоличество вхождений: $Вхождение")
    
    
    
    //Задача 4. «Космический магазин»
    пер КосмоТовары = [
        новый КосмоТовар("Лунный камень", 999, Редкость.Легендарный, 4),
        новый КосмоТовар("Реакторный чип", 599, Редкость.Редкий, 2),
        новый КосмоТовар("Часть метеорита", 299),
        новый КосмоТовар("Двигатель Х", 9999, Редкость.Легендарный, 5),
        новый КосмоТовар("Лунный кристалл", 99999, Редкость.Легендарный)
    ]
    
    
;