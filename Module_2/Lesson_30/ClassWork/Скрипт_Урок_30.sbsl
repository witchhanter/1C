//Практика


метод Скрипт()
    //Задача 1
    пер Цена = 1234.5678
    Консоль.Записать("Задача 1.\н${Цена.Представление("_.2' ₽'")}\н")
    
    //Задача 2.
    пер ДатаРождения = ДатаВремя{2010-03-15}
    пер ТекущаяДата2 = ДатаВремя.Сейчас()
    пер ПолныхЛет = ((ТекущаяДата2 - ДатаРождения).ВДнях() / 365).ЦелаяЧасть()
    Консоль.Записать("Задача 2.\н$ПолныхЛет полных лет\н")
    
    //Задача 3.
    пер Число3: Число | Строка = 12345
    Число3 = Число3.ВСтроку()
    пер Сумма: Число
    для Цифра из Число3 как Строка
        Сумма += новый Число(Цифра)
    ;
    Консоль.Записать("Задача 3.\н$Сумма\н")
    
    //Задача 4.
    пер ТекущаяДата4 = ДатаВремя.Сейчас()
    пер НовыйГод = ДатаВремя{2027-01-01}
    Консоль.Записать("Задача 4.\н${(НовыйГод - ТекущаяДата4).Дни} день до следующего нового года\н")
    
    //Задача 5.
    пер Слово = "топот".ВНижнийРегистр()
    пер Сообщение = Слово == Слово.Перевернуть() ? "является":"не является" 
    Консоль.Записать("Задача 5.\н\"$Слово\" $Сообщение палиндромом.\н")
    
    //Задача 6.
    пер Время = Время{14:05}
    Консоль.Записать("Задача 6.\н" + Время.Представление("ЧЧ' часа 'мм' минут'"))
    Консоль.Записать(Время.Час + " часа " + Время.Минута + " минут\н")
    
    //Задача 7.
    пер Число7 = 3.14159
    Консоль.Записать("Задача 7.\н" + Число7.Округлить(1, РежимОкругления.ПоловинаВверх))
    
    //Задача 8.
    пер Сегодня = Дата{2025-09-01}.ДобавитьДни(100).ДеньНедели()
    Консоль.Записать("\нЗадача 8.\нДень недели через 100 дней - $Сегодня\н")
    
    //Задача 9.
    пер Строка = " привет мир " 
    Консоль.Записать("Задача 9.\н$Строка\н${Строка.Сократить().ВВерхнийРегистр()}\н")
    
    //Задача 10.
    пер Первое = ДатаВремя{2025-10-10 9:30}
    пер Второе = ДатаВремя{2025-10-12 14:15}
    пер Разница = Второе - Первое
    Консоль.Записать("Задача 10.\нРазница: ${Разница.Часы} часа ${Разница.Минуты} минут.\н\н")
    
    
    //Повторение коллекций и структур
    Консоль.Записать("Повторение коллекций и структур\н")
    //Задание 1.
    пер Оценки = [4, 5, 3, 5, 4, 4]
    пер Сумма1: Число
    для Оценка из Оценки
        Сумма1 += Оценка
    ;
    пер СрАрифметическое = (Сумма1 / Оценки.Размер()).Округлить(2)
    Консоль.Записать("Задание 1.\н$СрАрифметическое\н")
    
    //Задание 2.
    пер ТелефонныйСправочник = новый Соответствие<Строка, Строка>()
    ТелефонныйСправочник.Вставить("Контакт 1", "89991112233")
    ТелефонныйСправочник.Вставить("Контакт 2", "89994445566")
    ТелефонныйСправочник.Вставить("Контакт 3", "89997778899")
    пер Имя = "Контакт 2"
    Консоль.Записать("Задание 2.\н" + ТелефонныйСправочник.ПолучитьИлиНеопределено(Имя))
;