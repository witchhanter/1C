метод Скрипт()
    
    //  ================
    //  = Подготовка 1 =
    //  ================
    Консоль.Записать("\н\нВариант 1\н\н")
    
    
    //Задание 1
    Консоль.Записать("Задание 1.")
    пер Оценки = [5, 4, 5, 3, 4]
    для Оценка из Оценки
        Консоль.Записать(Оценка)
    ;
    пер СрЗнач = Оценки.Среднее()
    Консоль.Записать("Средний балл: $СрЗнач\н")
    
    
    //Задание 2
    пер Числа = [2, 7, 4, 9, 12, 5, 8]
    пер КвоЧетных: Число
    для Число из Числа
        если Число % 2 == 0
            КвоЧетных += 1
        ;
    ;
    Консоль.Записать(
        "Задание 2.
        Числа: $Числа
        Количество четных: $КвоЧетных
        ")
    
    
    //Задание 3
    Консоль.Записать("Задание 3.")
    пер Ученики = ["Аня", "Петя", "Маша", "Игорь", "Аня"]
    пер Вхождения: Соответствие<Строка, Число>
    для Ученик из Ученики
        пер КвоВхождений: Число
        для Имя из Ученики
            если Имя == Ученик
                КвоВхождений += 1
            ;
        ;
        Вхождения.Вставить(Ученик, КвоВхождений)
    ;
    для Элемент из Вхождения
        Консоль.Записать(Элемент)
    ;
    
    
    
    
    //  ================
    //  = Подготовка 2 =
    //  ================
    Консоль.Записать("\н\нВариант 2\н\н")
    
    //Задание 1
    Консоль.Записать("Задание 1.")
    пер Оценки2 = [4, 4, 2, 5, 2]
    для Оценка из Оценки2
        Консоль.Записать(Оценка)
    ;
    пер СрЗнач2 = Оценки2.Среднее()
    Консоль.Записать("Средний балл: $СрЗнач2\н")    
        
        
    //Задание 2
    пер Числа2 = [11, 3, 17, 8, 16, 7, 13]
    пер КвоЧетных2: Число
    для Число из Числа2
        если Число % 2 == 0
            КвоЧетных2 += 1
        ;
    ;
    Консоль.Записать(
        "Задание 2.
        Числа: $Числа2
        Количество четных: $КвоЧетных2
        ")
    
    
    //Задание 3
    Консоль.Записать("Задание 3.")
    пер Ученики2 = ["Иван", "Миша", "Маша", "Иван", "Маша", "Игорь"]
    пер Вхождения2: Соответствие<Строка, Число>
    для Ученик из Ученики2
        пер КвоВхождений: Число
        для Имя из Ученики2
            если Ученик == Имя
                КвоВхождений += 1
            ;
        ;
        Вхождения2.Вставить(Ученик, КвоВхождений)
    ;
    для Элемент из Вхождения2
        Консоль.Записать(Элемент)
    ;
    
    
    
    //  ================
    //  = Подготовка 3 =
    //  ================
    Консоль.Записать("\н\нВариант 3\н\н")
    
    //Задание 1
    Консоль.Записать("Задание 1.")
    пер Оценки3 = [5, 3, 4, 5, 3]
    для Оценка из Оценки3
        Консоль.Записать(Оценка)
    ;
    пер СрЗнач3 = Оценки3.Среднее()
    Консоль.Записать("Средний балл: $СрЗнач3\н")    
        
        
    //Задание 2
    пер Числа3 = [3, 2, 14, 4, 7, 4, 16]
    пер КвоЧетных3: Число
    для Число из Числа3
        если Число % 2 == 0
            КвоЧетных3 += 1
        ;
    ;
    Консоль.Записать(
        "Задание 2.
        Числа: $Числа3
        Количество четных: $КвоЧетных3
        ")
    
    
    //Задание 3
    Консоль.Записать("Задание 3.")
    пер Ученики3 = ["Коля", "Оля", "Маша", "Оля", "Оля", "Иван"]
    пер Вхождения3: Соответствие<Строка, Число>
    для Ученик из Ученики3
        пер КвоВхождений: Число
        для Имя из Ученики3
            если Ученик == Имя
                КвоВхождений += 1
            ;
        ;
        Вхождения3.Вставить(Ученик, КвоВхождений)
    ;
    для Элемент из Вхождения3
        Консоль.Записать(Элемент)
    ;
;


метод ВыйгрышныйКод()
    //Задание 4_1    
    пер ЧислоПК: Строка
    пока ЧислоПК.Длина() != 8
        ЧислоПК += новый СлучайныйГенератор().СлучайноеЦелое(0,10)
    ;
    пер ЧислоЮ = Консоль.СчитатьСтроку("$ЧислоПК\нВведите Ваши позиции цифр в номере: ")
    пер СуммаПК: Число
    пер СуммаЮ: Число
    пер Результат: Строка
    для Цифра из ЧислоПК
        СуммаПК += новый Число(Цифра)
    ;
    для Цифра из ЧислоЮ
        пер Индекс = новый Число(Цифра) - 1
        СуммаЮ += новый Число(ЧислоПК[Индекс])
    ;
    СуммаПК = СуммаПК - СуммаЮ
    пока СуммаЮ >= 10 и СуммаПК >= 10
        пер Сумма2: Число
        пер Сумма1: Число
        для Цифра из СуммаПК.ВСтроку()
            Сумма2 += новый Число(Цифра)
        ;
        для Цифра из СуммаЮ.ВСтроку()
            Сумма1 += новый Число(Цифра)
        ;
        СуммаПК = Сумма2
        СуммаЮ = Сумма1
    ;
    если СуммаЮ > СуммаПК
        Результат = "Вы выиграли!"
    иначе
        Результат = "Вы проиграли!"
    ;
    Консоль.Записать("$Результат У Вас $СуммаЮ против $СуммаПК у соперника")
;

метод КаменьНожницыБумага()
    //Задание 4_2
    Консоль.Записать("Игра \"Камень-ножницы-бумага\"\нДля выхода введите любой символ кроме 1, 2, 3.\н")
    знч Выпадения = ["Камень", "Ножницы", "Бумага"]
    пер Проигрышные = ["НожницыКамень", "БумагаНожницы", "КаменьБумага"]
    пер ВыборПользователя: Строка
    пер Итог: Строка
    пока Истина
        пер ЧислоПользователя = Консоль.СчитатьЧисло("Выберите Камень(1), Ножницы(2), Бумага(3): ")
        пер ВыборКомпьютера = Выпадения[новый СлучайныйГенератор().СлучайноеЦелое(0, 3)]
        попытка 
            ВыборПользователя = Выпадения[ЧислоПользователя - 1]
        поймать Исключение: ИсключениеИндексВнеГраниц
            Консоль.Записать("Вы вышли из игры.")
            прервать
        ;
        если ВыборКомпьютера == ВыборПользователя
            Итог = "Ничья"
        иначе если Проигрышные.Содержит(ВыборПользователя + ВыборКомпьютера)
            Итог = "Вы проиграли"
        иначе
            Итог = "Вы выйграли"
        ;
        Консоль.Записать("Ваш вариант - $ВыборПользователя")
        Консоль.Записать("Вариант компьютера - $ВыборКомпьютера")
        Консоль.Записать("$Итог - $ВыборПользователя и $ВыборКомпьютера\н")
    ;
;

метод ПоискЧисла()
    //Задание 4_3
    пер Условие: Число
    пер Низ = 1
    пер Верх = 20
    пер Середина: Число
    пер КвоВопросов: Число
    пер Продолжение = Консоль.СчитатьЧисло("Загадайте целое число от 1 до 20 включительно. Введите 1, если загадали: ")
    если Продолжение == 1
        пока Верх > Низ
            Середина = ((Верх + Низ) / 2).ЦелаяЧасть()
            Условие = Консоль.СчитатьЧисло("Загаданное число меньше ${Середина + 1}? Введите 1, если да, иначе - 0: ")
            КвоВопросов += 1
            если Условие == 1
                Верх = Середина
            иначе
                Низ = Середина + 1
            ;
        ;
        Консоль.Записать("Загаданное число - $Низ. Ответ после $КвоВопросов вопросов")
    иначе
        Консоль.Записать("Нет загаданного числа - Выход.")
    ;
    
;