метод Скрипт()
    пер РабочаяПапка = ПутьКРабочейПапке()
    СозданиеОбъектов(РабочаяПапка)
    
    
    //Задание 1
    исп ПотокЗаписиТелефонногоСправоника = новый Файл("$РабочаяПапка/Задание 1/phonebook.xml").ОткрытьПотокЗаписи()
    знч ЗаписьТелефонногоСправочника = новый  ЗаписьXml(ПотокЗаписиТелефонногоСправоника)
    ЗаписьТелефонногоСправочника.ЗаписатьНачалоДокумента()
        .ЗаписатьНачалоЭлемента("ТелефоннаяКнига")
            .ЗаписатьНачалоЭлемента("Контакт")
                .ЗаписатьНачалоЭлемента("Имя").ЗаписатьТекст("Анна").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Номер").ЗаписатьТекст("555-1234").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Город").ЗаписатьТекст("Москва").ЗаписатьКонецЭлемента()
            .ЗаписатьКонецЭлемента()
            .ЗаписатьНачалоЭлемента("Контакт")
                .ЗаписатьНачалоЭлемента("Имя").ЗаписатьТекст("Анна").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Номер").ЗаписатьТекст("555-1234").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Город").ЗаписатьТекст("Москва").ЗаписатьКонецЭлемента()
            .ЗаписатьКонецЭлемента()      
        .ЗаписатьКонецЭлемента()
    .ЗаписатьКонецДокумента()
    Консоль.Записать("Задача 1.\нФайл создан.\н")
    
    
    
    //Задание 2
    Консоль.Записать("Задание 2.")
    исп ПотокЧтения = новый Файл("$РабочаяПапка/Задание 2/contacts.xml").ОткрытьПотокЧтения()
    знч Чтение = новый ЧтениеXml(ПотокЧтения)
    пер Имя = ""
    пер Телефон = ""
    пер Email = ""
    пока Чтение.Следующий()
        если Чтение.ВидУзла == ВидУзлаXml.НачалоЭлемента
            если Чтение.Имя == "Имя"
                Чтение.Следующий()
                Имя = Чтение.Значение
            иначе если Чтение.Имя == "Телефон"
                Чтение.Следующий()
                Телефон = Чтение.Значение
            иначе если Чтение.Имя == "Email"
                Чтение.Следующий()
                Email = Чтение.Значение
            иначе если Чтение.Имя == "Контакт"
                если Имя != ""
                    Консоль.Записать("Имя: $Имя, Телефон: $Телефон, Email: $Email")
                    Имя = ""
                    Телефон = ""
                    Email = ""
                ;
            ;
        ;
    ;
    если Имя != ""
        Консоль.Записать("Имя: $Имя, Телефон: $Телефон, Email: $Email")
    ;

    
    
    //Задание 3
    Консоль.Записать("\нЗадача 3.")
    пер ИмяДляПоиска = "Мария Сидорова"
    пер Найдено = Ложь
    пер Телефон3 = ""
    пер Email3 = ""
    исп ПотокЧтенияКонтактов3 = новый Файл("$РабочаяПапка/Задание 3/contacts.xml").ОткрытьПотокЧтения()
    знч ЧтениеКонтактов3 = новый ЧтениеXml(ПотокЧтенияКонтактов3)
    пока ЧтениеКонтактов3.Следующий()
        если ЧтениеКонтактов3.ВидУзла == ВидУзлаXml.НачалоЭлемента и ЧтениеКонтактов3.Имя == "Имя"
            ЧтениеКонтактов3.Следующий()
            если ЧтениеКонтактов3.Значение == ИмяДляПоиска
                Найдено = Истина
                пока ЧтениеКонтактов3.Следующий()
                    если ЧтениеКонтактов3.ВидУзла == ВидУзлаXml.НачалоЭлемента и ЧтениеКонтактов3.Имя == "Телефон"
                        ЧтениеКонтактов3.Следующий()
                        Телефон3 = ЧтениеКонтактов3.Значение
                    ;
                    если ЧтениеКонтактов3.ВидУзла == ВидУзлаXml.НачалоЭлемента и ЧтениеКонтактов3.Имя == "Email"
                        ЧтениеКонтактов3.Следующий()
                        Email3 = ЧтениеКонтактов3.Значение
                        прервать
                    ;
                ;
                Консоль.Записать("\"$ИмяДляПоиска\" есть в контактах.")
                Консоль.Записать("Телефон: $Телефон3\нEmail: $Email3\н")
                прервать
            ;
        ;
    ;
    если не Найдено
        Консоль.Записать("Контакт не найден")
    ;
    
    
    
    //Задание 4
    Консоль.Записать("Задание 4.")
    исп ПотокЧтения4 = новый Файл("$РабочаяПапка/Задание 4/contacts.xml").ОткрытьПотокЧтения()
    знч Чтение4 = новый ЧтениеДанных(ПотокЧтения4)
    пер ИсходныйТекст: Строка
    пока не Чтение4.ЧтениеЗавершено()
        ИсходныйТекст = ИсходныйТекст + Чтение4.ПрочитатьСтроку() + "\n"
    ;
    пер Строки = ИсходныйТекст.Разделить("<Контакт>")
    пер НовыйТекст: Строка
    пер Индекс = 1
    для Строка из Строки
        если Индекс == 1
            НовыйТекст = НовыйТекст + Строка
        иначе
            если Индекс % 2 == 0
                НовыйТекст = НовыйТекст + "<Контакт тип=\"работа\">" + Строка
            иначе
                НовыйТекст = НовыйТекст + "<Контакт тип=\"друг\">" + Строка
            ;
        ;
        Индекс = Индекс + 1
    ;
    исп ПотокЗаписи4 = новый Файл("$РабочаяПапка/Задание 4/contacts_new.xml").ОткрытьПотокЗаписи()
    знч Запись4 = новый ЗаписьДанных(ПотокЗаписи4)
    Запись4.ЗаписатьСтроку(НовыйТекст)
    Консоль.Записать("Обновлённый contacts.xml: \н$НовыйТекст")
    
    
    
    //Задание 5
    исп ПотокЗаписи5 = новый Файл("$РабочаяПапка/Задание 5/new_books.xml").ОткрытьПотокЗаписи()
    знч Запись5 = новый ЗаписьXml(ПотокЗаписи5)
    Запись5.ЗаписатьНачалоДокумента()
        .ЗаписатьНачалоЭлемента("МоиКниги")
            .ЗаписатьНачалоЭлемента("Книга")
                .ЗаписатьНачалоЭлемента("Название").ЗаписатьТекст("Преступление и наказание").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Автор").ЗаписатьТекст("Фёдор Михайлович Достоевский").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Год").ЗаписатьТекст("1866").ЗаписатьКонецЭлемента()
            .ЗаписатьКонецЭлемента()
            .ЗаписатьНачалоЭлемента("Книга")
                .ЗаписатьНачалоЭлемента("Название").ЗаписатьТекст("Гарри Поттер и философский камень").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Автор").ЗаписатьТекст("Джоан Роулинг").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Год").ЗаписатьТекст("2999").ЗаписатьКонецЭлемента()
            .ЗаписатьКонецЭлемента()
            .ЗаписатьНачалоЭлемента("Книга")
                .ЗаписатьНачалоЭлемента("Название").ЗаписатьТекст("Мастер и Маргарита").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Автор").ЗаписатьТекст("Михаил Афанасьевич Булгаков").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Год").ЗаписатьТекст("1967").ЗаписатьКонецЭлемента()
            .ЗаписатьКонецЭлемента()
        .ЗаписатьКонецЭлемента()
    .ЗаписатьКонецДокумента()
    Консоль.Записать("Задание 5.\нФайл с книгами успешно создан.\н")
    
    
    
    //Задание 6
    Файлы.Скопировать("$РабочаяПапка/Задание 5/new_books.xml", "$РабочаяПапка/Задание 6/books.xml")
    Консоль.Записать("Задание 6.")
    исп ПотокЧтения6 = новый Файл("$РабочаяПапка/Задание 6/books.xml").ОткрытьПотокЧтения()
    знч Чтение6 = новый ЧтениеXml(ПотокЧтения6)
    пер Счетчик: Число
    пер НазваниеКниги: Строка
    пер АвторКниги: Строка
    пока Чтение6.Следующий()
        если Чтение6.ВидУзла == ВидУзлаXml.НачалоЭлемента
            если Чтение6.Имя == "Название"
                Чтение6.Следующий()
                НазваниеКниги = Чтение6.Значение
                Счетчик += 1
            иначе если Чтение6.Имя == "Автор"
                Чтение6.Следующий()
                АвторКниги = Чтение6.Значение
                
                Консоль.Записать("$Счетчик) $НазваниеКниги - $АвторКниги")
            ;
        ;
    ;
    Консоль.Записать("Итого книг: $Счетчик\н")
    
    
    
    //Задание 7
    Консоль.Записать("Задание 7.")
    исп ПотокЧтения7 = новый Файл("$РабочаяПапка/Задание 7/products.xml").ОткрытьПотокЧтения()
    знч Чтение7 = новый ЧтениеXml(ПотокЧтения7)
    пер Первый = Истина
    пер Отступ: Строка
    пока Чтение7.Следующий()
        выбор Чтение7.ВидУзла
        когда НачалоЭлемента
            если Первый
                Первый = Ложь
            иначе
                Отступ += "  "
            ;
            Консоль.Записать("$Отступ ${Чтение7.Имя}")
            для Номер = 0 по Чтение7.КоличествоАтрибутов() - 1
                пер ИмяАтрибута = Чтение7.ИмяАтрибута(Номер)
                Консоль.Записать("$Отступ    Атрибут: $ИмяАтрибута = ${Чтение7.ЗначениеАтрибута(ИмяАтрибута)}")
            ;
        когда Текст
            Консоль.Записать("$Отступ  ${Чтение7.Значение}")
        когда КонецЭлемента
            если Отступ.Длина() >= 2
                Отступ = Отступ.ПодстрокаСНачала(Отступ.Длина() - 2)
            ;            
        ;
    ;
    
    
    
    //Задание 8 //не доделал
    /*8. «Поиск товара по атрибуту id»
Задача: Пользователь вводит id товара (например, «p002»). Найдите в products.xml товар с
таким атрибутом и выведите его наименование и цену. Используйте потоковое чтение и
проверку атрибутов.*/
    пер ID_товара = "2"
    // пер ID_товара = Консоль.СчитатьСтроку("Введите ID товара для поиска: ")
    пер НазваниеТовара8: Строка
    пер ЦенаТовара: Число
    исп ПотокЧтения8 = новый Файл("$РабочаяПапка/Задание 8/products.xml").ОткрытьПотокЧтения()
    знч Чтение8 = новый ЧтениеXml(ПотокЧтения8)
    пока Чтение8.Следующий()
        выбор Чтение8.ВидУзла
        когда НачалоЭлемента
            для Номер = 0 по Чтение8.КоличествоАтрибутов() - 1
                пер ИмяАтрибута = Чтение8.ИмяАтрибута(Номер) // id
                если Номер % 2 == 0 и Чтение8.ЗначениеАтрибута(ИмяАтрибута) == ID_товара
                    Консоль.Записать("${Чтение8.ЗначениеАтрибута(ИмяАтрибута)}") //2
                    прервать
                ;
            ;
            
        когда Текст
        ;
    ;

    
    
;

метод ПутьКРабочейПапке(): Строка
    пер ВыборЗаписи = Консоль.СчитатьЧисло("Введите число для создания каталога с нужными файлами с клавиатуры:\н1 - ввести путь \н2 - использовать автоматический путь.\н > ")
    пер МестоКаталогаДляПроверки = "/"
    если ВыборЗаписи == 1
        МестоКаталогаДляПроверки = Консоль.СчитатьСтроку("Введите путь: ")
    иначе
        МестоКаталогаДляПроверки = "/home/${СредаИсполнения.ПолучитьПеременную("USER")}/Документы/1С.Занятие 34/"
        если СредаИсполнения.ПолучитьСвойство("os.name").Найти("Windows") != -1
            МестоКаталогаДляПроверки = "D:\\1С.Занятие 34\\"
        ;
    ;
    возврат МестоКаталогаДляПроверки
;

метод СозданиеОбъектов(МестоКаталогаДляПроверки: Строка)
    для НомерКаталога = 1 по 8
        Файлы.СоздатьКаталог(МестоКаталогаДляПроверки + "Задание $НомерКаталога")
    ;
    //файл контактов
    исп ПотокЗаписиКонтактов = новый Файл("$МестоКаталогаДляПроверки/Задание 2/contacts.xml").ОткрытьПотокЗаписи()
    знч ЗаписьКонтактов = новый  ЗаписьXml(ПотокЗаписиКонтактов)
    ЗаписьКонтактов.ЗаписатьНачалоДокумента()
        .ЗаписатьНачалоЭлемента("Контакты")
            .ЗаписатьНачалоЭлемента("Контакт")
                .ЗаписатьНачалоЭлемента("Имя").ЗаписатьТекст("Иван Петров").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Телефон").ЗаписатьТекст("+7(999)123-45-67").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Email").ЗаписатьТекст("ivan@example.com").ЗаписатьКонецЭлемента()
            .ЗаписатьКонецЭлемента()
            .ЗаписатьНачалоЭлемента("Контакт")
                .ЗаписатьНачалоЭлемента("Имя").ЗаписатьТекст("Мария Сидорова").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Телефон").ЗаписатьТекст("+7(999)765-43-21").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Email").ЗаписатьТекст("maria@example.com").ЗаписатьКонецЭлемента()
            .ЗаписатьКонецЭлемента()     
        .ЗаписатьКонецЭлемента()
    .ЗаписатьКонецДокумента()
    
    пер Контакты = новый Файл("$МестоКаталогаДляПроверки/Задание 2/contacts.xml")
    Файлы.Скопировать(Контакты, "$МестоКаталогаДляПроверки/Задание 3/contacts.xml")
    Файлы.Скопировать(Контакты, "$МестоКаталогаДляПроверки/Задание 4/contacts.xml")

    //Файл продуктов для задания 7
    исп ПотокЗаписиПродуктов = новый Файл("$МестоКаталогаДляПроверки/Задание 7/products.xml").ОткрытьПотокЗаписи()
    знч ЗаписьПродуктов = новый ЗаписьXml(ПотокЗаписиПродуктов)
    ЗаписьПродуктов.ЗаписатьНачалоДокумента()
        .ЗаписатьНачалоЭлемента("Товары")
            .ЗаписатьНачалоЭлемента("Товар").ЗаписатьАтрибут("id", "1").ЗаписатьАтрибут("категория", "электроника")
                .ЗаписатьНачалоЭлемента("Название").ЗаписатьТекст("Ноутбук").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Цена").ЗаписатьТекст("50000").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Наличие").ЗаписатьТекст("Истина").ЗаписатьКонецЭлемента()
            .ЗаписатьКонецЭлемента()
            .ЗаписатьНачалоЭлемента("Товар").ЗаписатьАтрибут("id", "2").ЗаписатьАтрибут("категория", "одежда")
                .ЗаписатьНачалоЭлемента("Название").ЗаписатьТекст("Футболка").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Цена").ЗаписатьТекст("1500").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Наличие").ЗаписатьТекст("Ложь").ЗаписатьКонецЭлемента()
            .ЗаписатьКонецЭлемента()
            .ЗаписатьНачалоЭлемента("Товар").ЗаписатьАтрибут("id", "3").ЗаписатьАтрибут("категория", "книги")
                .ЗаписатьНачалоЭлемента("Название").ЗаписатьТекст("Программирование на 1С").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Цена").ЗаписатьТекст("1200").ЗаписатьКонецЭлемента()
                .ЗаписатьНачалоЭлемента("Наличие").ЗаписатьТекст("Истина").ЗаписатьКонецЭлемента()
            .ЗаписатьКонецЭлемента()
        .ЗаписатьКонецЭлемента()
    .ЗаписатьКонецДокумента()
    
    Файлы.Скопировать("$МестоКаталогаДляПроверки/Задание 7/products.xml", "$МестоКаталогаДляПроверки/Задание 8/products.xml")
    
    
    
    Консоль.Записать("Нужные каталоги успешно созданы по адресу \"$МестоКаталогаДляПроверки\".\н\н")
;