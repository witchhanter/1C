метод Скрипт()
    //Методы строк
    /*
    пер Поле: Строка // = "имя"
    если Поле.Пусто()
        Консоль.Записать("Обязательное поле!")
    ;
    
    пер НомерКарты = "2222333344445555"
    Консоль.Записать(НомерКарты.Вставить(4, "-").Вставить(9, "-").Вставить(14, "-"))
    
    пер Текст = 
        "<body> 
            <p>Картинка  1 <img src=\"С:\\Example\\Images\\pic1.png\" /></p> 
            <p>Картинка  2 <img src=\"С:\\Example\\Images\\pic2.png\" /></p> 
            <p>Картинка  3 <img src=\"С:\\Example\\Images\\pic3.png\" /></p> 
        </body>"
    
    //Удалить из строки
    Консоль.Записать(Текст)
    пер НовыйТекст = Текст.Удалить("\\Example")
    Консоль.Записать(НовыйТекст)
    
    пер СтарыйНомер = "Договор_2026-203"
    пер НовыйНомер = СтарыйНомер.УдалитьДиапазон(8, 10)
    Консоль.Записать(НовыйНомер)
    
    //Заменить
    НовыйТекст = Текст.Заменить("png", "jpg")
    Консоль.Записать(НовыйТекст)
    
    //Работа со строками многострочной переменной
    пер Лог =
        "2025/08/12-15:01:09.406,pid=15228,tid=6072,component=launcher,class=Daemon… 
        2025/08/12-15:01:09.422,pid=15228,tid=18188,component=launcher,class=Daemon… 
        2025/08/12-15:01:09.422,pid=15228,tid=6072,component=launcher,class=JMethodCaller… 
        2025/08/12-15:01:09.422,pid=15228,tid=18188,component=launcher,class=Daemon… 
        2025/08/12-15:01:09.422,pid=15228,tid=18188,component=launcher,class=JavaVmManager… " 
    для СтрокаЛога из Лог.ПолучитьСтроки()  
        для ЧастьСтроки из СтрокаЛога.Разделить(",") 
            Консоль.Записать(ЧастьСтроки)
        ;
    ;
    
    //Сравнить, если Истина - то игнорирует регистр
    пер ИмяТега = "BODY"
    если ИмяТега.Сравнить("body", Истина) == 0
        Консоль.Записать("Тег найден.")
    
    ;
    
    //Сократить строку (только с начала или с конца)
    пер Наименование = "           Молоко    "
    пер ПравильноеНаименование = Наименование.Сократить()
    Консоль.Записать("$Наименование\н$ПравильноеНаименование")
    Консоль.Записать(Наименование.СократитьСКонца())
    Консоль.Записать(Наименование.СократитьСНачала())
    
    //НачинаетсяС, ЗаканчиваетсяНа
    пер  URL = "1c://?WS=https://test.app-site.com/app-name" 
    если  URL.НачинаетсяС("1c://")  
        Консоль.Записать("Загрузить учебник")
    ; 
    
    //ДополнитьСНачала, ДополнитьСКонца
    пер ПервыйФайл = "2.txt"
    пер ВторойФайл = "41.txt"
    Консоль.Записать(ПервыйФайл.ДополнитьСНачала(7, "*")) //дополнить "0" до длины строки 7
    Консоль.Записать(ВторойФайл.ДополнитьСНачала(7, "*"))
    
    //ТолькоЦифры, ТолькоБуквы
    пер Пароль = "Тест_1234"
    если не Пароль.ТолькоЦифры()
        Консоль.Записать("Добавь цифры")
    иначе если не Пароль.ТолькоБуквы()
        Консоль.Записать("Добавь буквы")
    иначе если Пароль.ТолькоБуквыИлиЦифры()
        Консоль.Записать("Добавь символы")
    иначе
        Консоль.Записать("Хороший пароль!")
    ;
    */
    
    
    
    
    
    //программа на надежность пароля: 
    //длина >= 8; есть буквы, цифры, спец.символы
    пока Истина
        пер Пароль = Консоль.СчитатьСтроку("\нПароль: ")
        знч СпецСимволы = "!@$№#&^_:-;*~"
        //создание флагов
        пер ДопустимаяДлина = Пароль.Длина() >= 8
        пер ЕстьЗаглавнаяБуква: Булево
        пер ЕстьСтрочнаяБуква: Булево
        пер ЕстьЦифра: Булево
        пер ЕстьСпецСимвол: Булево

        для Символ из Пароль
            если Символ.ТолькоБуквы()
                если Символ.ВВерхнийРегистр() == Символ
                    ЕстьЗаглавнаяБуква = Истина
                иначе если Символ.ВНижнийРегистр() == Символ
                    ЕстьСтрочнаяБуква = Истина
                ;
            иначе если Символ.ТолькоЦифры()
                ЕстьЦифра = Истина
            иначе если СпецСимволы.Содержит(Символ)
                ЕстьСпецСимвол = Истина
            ;
        ;
        если ДопустимаяДлина и ЕстьЗаглавнаяБуква и ЕстьСтрочнаяБуква и ЕстьЦифра и ЕстьСпецСимвол == Истина
            Консоль.Записать("Надежный пароль")
            прервать
        иначе
            если не ДопустимаяДлина
                Консоль.Записать("Недостаточная длина пароля!")
            ;
            если не ЕстьЦифра
                Консоль.Записать("Пароль не содержит цифр!")
            ;
            если не ЕстьЗаглавнаяБуква
                Консоль.Записать("Пароль не содержит заглавных букв!")
            ;
            если не ЕстьСтрочнаяБуква
                Консоль.Записать("Пароль не содержит строчных букв!")
            ;
            если не ЕстьСпецСимвол
                Консоль.Записать("Пароль не содержит спецсимволы!")
            ;
        ;  
    ;
;