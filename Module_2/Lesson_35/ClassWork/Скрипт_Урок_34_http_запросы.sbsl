метод КаменьНожницыБумага()
    //Игра камень, ножницы, бумага 
    Консоль.Записать("Для выхода введите любой символ кроме 1, 2, 3.\н")
    пока Истина
        знч Выпадения = ["Камень", "Ножницы", "Бумага"]
        пер ЧислоПользователя = Консоль.СчитатьЧисло("Выберите Камень(1), Ножницы(2), Бумага(3): ")
        пер ВыборПользователя: Строка
        пер РандомныйИндекс = новый СлучайныйГенератор().СлучайноеЦелое(0, 3)
        пер ВыборКомпьютера = Выпадения[РандомныйИндекс]
        пер Итог: Строка
        // ВыборПользователя = Выпадения[ЧислоПользователя - 1]
        выбор ЧислоПользователя
        когда 1
            ВыборПользователя = "Камень"
        когда 2
            ВыборПользователя = "Ножницы"
        когда 3
            ВыборПользователя = "Бумага"
        иначе
            Консоль.Записать("Вы вышли из игры.")
            прервать
        ;
        если ВыборКомпьютера == ВыборПользователя
            Итог = "Ничья - $ВыборПользователя и $ВыборКомпьютера"
        иначе если ВыборПользователя == "Ножницы" и ВыборКомпьютера == "Камень"
            Итог = "Вы проиграли - $ВыборПользователя и $ВыборКомпьютера"
        иначе если ВыборПользователя == "Бумага" и ВыборКомпьютера == "Ножницы"
            Итог = "Вы проиграли - $ВыборПользователя и $ВыборКомпьютера"
        иначе если ВыборПользователя == "Камень" и ВыборКомпьютера == "Бумага"
            Итог = "Вы проиграли - $ВыборПользователя и $ВыборКомпьютера"
        иначе
            Итог = "Вы выйграли - $ВыборПользователя и $ВыборКомпьютера"
        ;
        Консоль.Записать("Ваш вариант - $ВыборПользователя")
        Консоль.Записать("Вариант компьютера - $ВыборКомпьютера")
        Консоль.Записать("$Итог\н")
    ;
;

метод УгадайЧисло()
    пер ЗагаданноеЧисло = новый СлучайныйГенератор().СлучайноеЦелое(1, 11)
    пер КвоПопыток = 1
    Консоль.Записать("Число загадано. Есть 10 попыток.\н")
    пока КвоПопыток != 11
        пер ЧислоПользователя = Консоль.СчитатьЧисло("> Введите число: ")
        пер Комментарий = "Потрачено $КвоПопыток/10 попыток\н"
        выбор ЧислоПользователя
        когда == ЗагаданноеЧисло
            Консоль.Записать("Вы угадали! Компьютер загадал число $ЗагаданноеЧисло")
            прервать
        когда > ЗагаданноеЧисло
            Консоль.Записать("Загаданное число больше введенного! ")
        когда < ЗагаданноеЧисло
            Консоль.Записать("Загаданное число меньше введенного!")
        ;
        Консоль.Записать(Комментарий)
        КвоПопыток += 1
    ;
;

метод СуммаЦифрЧисла()
    пер Число = 12345
    пер СуммаЦифр: Число
    пер ЧИслоВСтроке = Число.ВСтроку()
    для Цифра из ЧИслоВСтроке
        СуммаЦифр += новый Число(Цифра)
    ;
    Консоль.Записать(СуммаЦифр)
;