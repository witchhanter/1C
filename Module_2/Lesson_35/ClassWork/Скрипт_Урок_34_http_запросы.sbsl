метод Скрипт()
    // https://http-test.1cmycloud.com/applications/school/api/diary//schedules/day?date=19-04-2025
    //curl ссылка //windows
    
    знч  Запрос1  = КлиентHttp.ЗапросGet("https://http-test.1cmycloud.com/applications/school/api/diary/schedules/day")
    Запрос1.УстановитьТипСодержимого("application/json").ДобавитьЗаголовок("Accept", "application/json")
    исп Результат1 = Запрос1.Выполнить()
    знч КодСтатуса1 = Результат1.КодСтатуса
    пер ТелоСтрока1 = Результат1.Тело.ПрочитатьКакСтроку()
    
    
    //отправка уточняющего запроса на базовый url
    знч  Запрос2  = КлиентHttp.СБазовымUrl("https://http-test.1cmycloud.com/applications/school/api/diary/")
    исп Результат2 = Запрос2.ЗапросGet("schedules/day/5").Выполнить() //уроки 5-ого дня
    пер Уроки: неизвестно = СериализацияJson.ПрочитатьОбъект(Результат2.Тело.ПрочитатьКакСтроку())
    для Урок из Уроки
        // Консоль.Записать("${Урок["НомерУрока"]} ${Урок["Предмет"]}, ${Урок["Кабинет"]} ")
    ;
    
    //посмотреть примеры GET-запросов на стр 277-278 в учебнике
    // УгадайЧисло()
    
    
;

