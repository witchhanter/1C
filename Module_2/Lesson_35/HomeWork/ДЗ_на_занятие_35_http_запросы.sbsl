метод Скрипт()
    
    
    //Задание 1
    исп  Запрос1  = КлиентHttp.ЗапросGet("https://http-test.1cmycloud.com/applications/school/api/diary/schedules/day").Выполнить()
    Консоль.Записать("Задание 1.\н${Запрос1.Тело.ПрочитатьКакСтроку()}\нКод статуса: ${Запрос1.КодСтатуса}\н")
    
    
    //Задание 2
    Консоль.Записать("Задание 2.")
    исп  Запрос2  = КлиентHttp.СБазовымUrl("https://http-test.1cmycloud.com/applications/school/api/diary/").ЗапросGet("schedules/day/5").Выполнить()
    пер Уроки2: неизвестно = СериализацияJson.ПрочитатьОбъект(Запрос2.Тело.ПрочитатьКакСтроку())
    для Урок из Уроки2
        Консоль.Записать("${Урок["НомерУрока"]} ${Урок["Предмет"]}, ${Урок["Кабинет"]} ")
    ;
    
    
    //Задание 3
    исп Запрос3 = КлиентHttp.ЗапросGet("https://http-test.1cmycloud.com/applications/school/api/diary/schedules/day?date=19-04-2025").Выполнить()
    Консоль.Записать("\нЗадание 3.\н${Запрос3.Тело.ПрочитатьКакСтроку()}\нКод статуса: ${Запрос3.КодСтатуса}\н")

    
    //Задание 4
    пер Тело4 = 
    "{
        \"сообщение\": \"Привет, сервер!\",
        \"отправитель\": \"Ученик 10 класса\"
    }"
    знч Запрос4 = КлиентHttp.ЗапросPost("https://http-test.1cmycloud.com/applications/school/api/query")
    Запрос4.УстановитьТипСодержимого("application/json").УстановитьТело(Тело4)
    исп Результат4 = Запрос4.Выполнить()
    Консоль.Записать(
        "Задание 4.
        Код статуса: ${Результат4.КодСтатуса}
        Тело ответа:
        ${Результат4.Тело.ПрочитатьКакСтроку()}\н"
    )
    
    
    //Задание 5
    Консоль.Записать("Задание 5.")
    знч Запрос5 = КлиентHttp.ЗапросGet("https://http-test.1cmycloud.com/applications/school/api/diary/schedules/day").ДобавитьЗаголовок("Accept", "application/json")
    исп Результат5 = Запрос5.Выполнить()
    пер ТипСодержимого = Результат5.Заголовки.ПолучитьВсе("Content-Type")
    если ТипСодержимого.Содержит("application/json")
        Консоль.Записать("Тип содержимого соответствует JSON")
    иначе
        Консоль.Записать("Тип содержимого: $ТипСодержимого")
    ;
    Консоль.Записать("Первые 100 символов тела:\н${Результат5.Тело.ПрочитатьКакСтроку().ПодстрокаСНачала(100)}\н")
    
    
    //Задание 6
    Консоль.Записать("Задание 6.")
    знч Запрос6 = КлиентHttp.ЗапросGet("https://http-test.1cmycloud.com/applications/school/api/diary/schedules/notfoundday")
    попытка
        исп Результат6 = Запрос6.Выполнить()
        Консоль.Записать(
            "Код статуса: ${Результат6.КодСтатуса}
            Ошибка: ресурс не найден\н"
        )
    поймать Искл: ИсключениеHttp
        Консоль.Записать("Исключение: ${Искл.Описание}\н")
    ;
    
    
    //Задание 7
    Консоль.Записать("Задание 7.\нЗаголовки ответа:")
    исп Запрос7 = КлиентHttp.ЗапросGet("https://http-test.1cmycloud.com/applications/school/api/query").ДобавитьЗаголовок("Authorization", "Bearer demo-token-123").Выполнить()
    для ИмяЗаголовка из Запрос7.Заголовки.Имена()
        Консоль.Записать("$ИмяЗаголовка: ${Запрос7.Заголовки.ПолучитьВсе(ИмяЗаголовка)}")
    ;
    пер RequestId = Запрос7.Заголовки.ПолучитьВсе("x-request-id")
    если RequestId.Граница() >= 0
        Консоль.Записать("\нЗначение x-request-id: $RequestId\н")
    иначе
        Консоль.Записать("\нЗаголовок x-request-id не найден\н")
    ;
    
    
    //Задание 8
    пер Тело8 = "username=ivan&score=100"
    исп Запрос8 = КлиентHttp.ЗапросPost("https://http-test.1cmycloud.com/applications/school/api/query").УстановитьТипСодержимого("application/x-www-form-urlencoded").УстановитьТело(Тело8).Выполнить()
    Консоль.Записать("Задание 8.\н${Запрос8.Тело.ПрочитатьКакСтроку()}\н")
    
    
    //Задание 9
    Консоль.Записать(
        "Задание 9.
        1) ${ПроверитьСервер("https://http-test.1cmycloud.com/applications/school/api/diary/schedules/day")}
        2) ${ПроверитьСервер("https://http-test.1cmycloud.com/applications/school/api/diary/notexists")}\н"
    )
    
    
    //Задание 10
    исп Запрос10 = КлиентHttp.ЗапросGet("https://http-test.1cmycloud.com/applications/school/api/diary/schedules/week").Выполнить()
    пер Тело10 = Запрос10.Тело.ПрочитатьКакСтроку()
    пер Расписание = СериализацияJson.ПрочитатьОбъект(Тело10) как Соответствие<Строка, Объект?>
    Консоль.Записать("\нЗадание 10.")
    для День из Расписание.Ключи()
        пер Уроки = Расписание.Получить(День) как Массив<Объект?>
        Консоль.Записать("\н$День:")
        для ИндексУрока = 0 по Уроки.Граница()
            пер Урок = Уроки[ИндексУрока] как Соответствие<Строка, Объект?>
            пер Номер = Урок.Получить("НомерУрока")
            пер Предмет = Урок.Получить("Предмет")
            пер Кабинет = Урок.Получить("Кабинет")
            Консоль.Записать("  - $Номер урок: $Предмет, каб. $Кабинет")
        ;
    ;
    
    
;

//9
метод ПроверитьСервер(URL: Строка): Булево
    пер Статус = Истина
    исп Запрос9 = КлиентHttp.ЗапросGet(URL).Выполнить()
    если Запрос9.КодСтатуса != 200
        Статус = Ложь
    ;    
    возврат Статус
;