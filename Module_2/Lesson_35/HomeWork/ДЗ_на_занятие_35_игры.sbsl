метод КаменьНожницыБумага()
    Консоль.Записать("Игра \"Камень-ножницы-бумага\"\нДля выхода введите любой символ кроме 1, 2, 3.\н")
    знч Выпадения = ["Камень", "Ножницы", "Бумага"]
    пер Проигрышные = ["НожницыКамень", "БумагаНожницы", "КаменьБумага"]
    пер ВыборПользователя: Строка
    пер Итог: Строка
    пока Истина
        пер ЧислоПользователя = Консоль.СчитатьЧисло("Выберите Камень(1), Ножницы(2), Бумага(3): ")
        пер ВыборКомпьютера = Выпадения[новый СлучайныйГенератор().СлучайноеЦелое(0, 3)]
        попытка 
            ВыборПользователя = Выпадения[ЧислоПользователя - 1]
        поймать Исключение: ИсключениеИндексВнеГраниц
            Консоль.Записать("Вы вышли из игры.")
            прервать
        ;
        если ВыборКомпьютера == ВыборПользователя
            Итог = "Ничья"
        иначе если Проигрышные.Содержит(ВыборПользователя + ВыборКомпьютера)
            Итог = "Вы проиграли"
        иначе
            Итог = "Вы выйграли"
        ;
        Консоль.Записать("Ваш вариант - $ВыборПользователя")
        Консоль.Записать("Вариант компьютера - $ВыборКомпьютера")
        Консоль.Записать("$Итог - $ВыборПользователя и $ВыборКомпьютера\н")
    ;
;

метод УгадайЧисло()
    пер ЗагаданноеЧисло = новый СлучайныйГенератор().СлучайноеЦелое(1, 11)
    пер КвоПопыток = 1
    Консоль.Записать("Игра \"Угадай число\"\нЧисло загадано. Есть 10 попыток.\н")
    пока КвоПопыток != 11
        пер ЧислоПользователя = Консоль.СчитатьЧисло("\н> Введите число: ")
        пер Комментарий = "Потрачено $КвоПопыток/10 попыток"
        выбор ЧислоПользователя
        когда == ЗагаданноеЧисло
            Консоль.Записать("Вы угадали! Компьютер загадал число $ЗагаданноеЧисло")
            прервать
        когда > ЗагаданноеЧисло
            Консоль.Записать("Загаданное число больше введенного! ")
        когда < ЗагаданноеЧисло
            Консоль.Записать("Загаданное число меньше введенного!")
        ;
        Консоль.Записать(Комментарий)
        КвоПопыток += 1
    ;
    если КвоПопыток >= 11
        Консоль.Записать("Попытки закончились.")
    ;
;

метод СуммаЦифрЧисла()
    пер Число = (12345).ВСтроку()
    Консоль.Записать("Подсчет суммы цифр числа $Число, пока оно не станет однозначным.\н")
    пока Число.Длина() != 1
        пер Сумма: Число
        для Цифра из Число
            Сумма += новый Число(Цифра)
        ;
        Консоль.Записать(Сумма)
        Число = Сумма.ВСтроку()
    ;
;