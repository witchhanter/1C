//= Практика =
//============

структура Книга
    обз знч Название: Строка
    обз знч Автор: Строка
    пер Год = 2024
    пер Оценка: Число
    
    метод ПовыситьОценку()
        если Оценка < 5
            Оценка += 1
        ;
    ;
;
метод Скрипт()
    
    //Задание 1. Структуры
    пер МоиКниги: Массив<Книга>
    МоиКниги.Добавить(новый Книга("Война и мир", "Л.Н.Толстой", 1990))
    МоиКниги[0].ПовыситьОценку()
    /*
    //Массивы
    
    //Задание 11
    пер Оценки = [4, 5, 3, 5, 4, 2, 5]
    пер СреднийБалл = Оценки.Среднее()
    пер КвоПятёрок: Число
    для Оценка из Оценки
        если Оценка == 5
            КвоПятёрок += 1
        ;
    ;
    Консоль.Записать("Задание 11.\н$Оценки\н$СреднийБалл\н$КвоПятёрок\н")
    
    // Задание 12
    пер Песни = ["Калинка", "Катюша", "Уральская рябинушка", "Смуглянка", "Берёзка"]
    Консоль.Записать("Задание 12.\нИсходный плейлист: $Песни")
    для Песня = 0 по Песни.Размер() + 1
        пер ПесняВырезать = Песни.УдалитьПоИндексу(новый СлучайныйГенератор().СлучайноеЦелое(0,5))
        Песни.Вставить(новый СлучайныйГенератор().СлучайноеЦелое(0,3), ПесняВырезать) 
    ;
    Консоль.Записать("Перемешанный плейлист: $Песни\н")
    
    //Задание 14
    пер Результаты = [3, 0, 1, 3, 3, 0, 1, 3]
    пер КвоОчков = Результаты.Сумма()
    пер Победы: Число
    пер Ничьи: Число
    пер Поражения: Число
    для Результат из Результаты
        выбор Результат
        когда 3
            Победы += 1
        когда 1
            Ничьи += 1
        когда 0
            Поражения += 1
        ;
    ;
    Консоль.Записать("Задание 14.\нРезультаты: $Результаты")
    Консоль.Записать("Общее количество очков: $КвоОчков. Побед: $Победы, Ничьих: $Ничьи, Поражений: $Поражения\н")
        
    //Задание 15
    пер ДниНедели = ["ПН", "ВТ", "СР", "ЧТ", "ПТ", "СБ", "ВС"]
    пер НовыеДниНедели: Массив<Строка>
    Консоль.Записать("Задание 15.\н$ДниНедели")
    для День из ДниНедели
        выбор ДниНедели.Найти(День)
        когда <= 4
            НовыеДниНедели.Добавить("Работа")
        иначе
            НовыеДниНедели.Добавить("Отдых")
        ;
    ;
    Консоль.Записать(НовыеДниНедели)
    
    //Задание 16
    пер Буквы = ["А", "Б", "В", "Г", "Д"]
    пер Сдвиг = Консоль.СчитатьЧисло("Введите сдвиг: ")


    
    
    //Задание 23. Соответствия
    пер Персонаж = {"Сила":25, "Ловкость":18, "Интеллект":22, "Здоровье":100}
    УвеличитьХарактеристики(Персонаж, "Сила", 15)
    
    //Задание 21. Множества
    пер Планы = {"Убрать комнату", "Сделать уроки", "Погулять с собакой", "Почитать книгу"}
    Планы.Добавить("Помыть посуду")
    Планы.Добавить("Вынести мусор")
    Планы.Удалить("Сделать уроки")
     */
     
    
    
;

метод УвеличитьХарактеристики(Персонаж: Соответствие<Строка, Число>, Характеристика: Строка, Значение: Число)
    если Персонаж.СодержитКлюч(Характеристика)
        Персонаж[Характеристика] += Значение
    ;
;