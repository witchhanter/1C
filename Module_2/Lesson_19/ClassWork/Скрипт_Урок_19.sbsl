    // БазовыеТипы = СобратьПредков(Тип<Массив<Число>>, Ложь)
    
    пер Базовое: Представляемое = 5
    пер Производное: Число = 5
    // Базовое = Производное
    // Консоль.Записать(Базовое.ПолучитьТип().Представление())
    
    // СравнитьСЧислом("65")
    // СравнитьСЧислом(56)
    // СравнитьСЧислом("текст")
    // СравнитьСЧислом(Истина)
    
    // пер СтрокаЧисло = "123.45"
    // пер ЧислоЗначения = новый Число(СтрокаЧисло)
    // Консоль.Записать(ЧислоЗначения.ПолучитьТип().Представление())
    
    ОписатьОбъект(42)
    ОписатьОбъект("Привет")
    ОписатьОбъект(Истина)
    ОписатьОбъект(ДатаВремя.Сейчас())
;

метод ОписатьОбъект(Значение: Объект)
    если Значение это Число
        Консоль.Записать(Значение.Представление() + " - это число")
    иначе если Значение это Строка
        Консоль.Записать(Значение.Представление() + " - это строка")
    иначе если Значение это Булево
        Консоль.Записать(Значение.Представление() + " - это истина или ложь")
    иначе
        Консоль.Записать(Значение.Представление() + " - это что то другое")
    ;
;
метод СравнитьСЧислом(Значение: Объект)
    если Значение это не Число|Строка
        Консоль.Записать(Значение.Представление() + " - это не число и не строка")
    ;   
;

метод  СобратьПредков(Значение:  Тип,  Рекурсия:  Булево,  Предки:  Строка  = ""): Строка
    для  БазовыйТип  из  Значение.БазовыеТипы
        если  не  Рекурсия
            Консоль.Записать("---  " + Значение.Представление())
        ;
        Консоль.Записать(БазовыйТип.Представление())
        СобратьПредков(БазовыйТип,  Истина,  Предки)
    ;
    возврат  Предки
;

