метод Скрипт()
    /*пер МоеВремя = Время{18:00:30.999}
    пер МояДата = Дата{2026-05-07}
    пер МоеДатаВремя = ДатаВремя{2026-05-07 18:00:30.001}
    
    пер МояДлительность = 1д14ч30м //самые большие - дни (д)
    
    пер МойМомент1 = Момент{2026-05-07 18:00:30.001 UTC+3} //абсолютное время (время - часовой пояс)
    пер МойМомент2 = Момент{2026-05-07 18:00:30.001 UTC+7}
    пер МойМомент3 = Момент{2026-05-07 18:00:30.001 UTC+0}
    
    пер МойЧасовойПояс = ЧасовойПояс{+3} //не имеет значения по умолчанию
    пер МоеСейчас = ДатаВремя.Сейчас(МойЧасовойПояс)
    
    пер ПустоеВремя: Время
    пер ПустаяДата: Дата
    пер ПустаяДатаИВремя: ДатаВремя
    пер ПустаяДлительность: Длительность
    пер ПустойМомент: Момент
    
    
    
    
    пер НачалоКаникул = Дата{2026-06-01}
    пер КонецКаникул = НачалоКаникул + 92д
    Консоль.Записать(КонецКаникул)
    КонецКаникул = НачалоКаникул.ДобавитьДни(92)
    Консоль.Записать(КонецКаникул.ВСтроку())
    КонецКаникул = НачалоКаникул.ДобавитьМесяцы(3)
    Консоль.Записать(КонецКаникул.Представление())
    
    пер ДатаМероприятия = ДатаВремя{2026-05-25 9:30:00}
    пер Сообщение = "Последний звонок запланирован на $ДатаМероприятия" //при интерполяции для ДатаВремя используется неявным образом метод Представление() //!Только с $
    пер Сообщение2 = ДатаМероприятия.Представление("'Событие произойдет 'дд ММММ гггг' в 'ЧЧ:мм' ('дддд')'") //в одиночных кавычках текст без изменений
    Консоль.Записать(Сообщение)
    Консоль.Записать(Сообщение2)
    
    
    //Дни недели
    пер ДатаВстречи = Дата{2026-05-14}
    если ДатаВстречи.ДеньНедели() == ДеньНедели.Четверг
        Консоль.Записать("Урок есть.")
    иначе
        Консоль.Записать("Урока нет.")
    ;
    Консоль.Записать(ДатаВстречи.ДеньГода())
    
    
    пер ЛокальноеВремяКрасноярск = ДатаВремя{2026-05-07 13:00}
    пер Момент1 = ЛокальноеВремяКрасноярск.ВМомент(ЧасовойПояс{+7})
    Консоль.Записать("$Момент1")
    
    пер МоментВКрасноярске = Момент{2026-05-07 23:02 +7}
    пер ЛокальноеВремя = МоментВКрасноярске.ВДатаВремя(ЧасовойПояс{+3})
    Консоль.Записать("$ЛокальноеВремя")
    Консоль.Записать(МоментВКрасноярске.Представление())
    Консоль.Записать("$МоментВКрасноярске")
    
    
    //Длительность
    пер НачалоКаникул = новый ДатаВремя(2026, 06, 01)
    пер КонецКаникул = ДатаВремя{2026-09-01}
    пер ДлительностьКаникул = КонецКаникул - НачалоКаникул
    Консоль.Записать(ДлительностьКаникул.Дни)
*/
    //Задача 1
    пер НачалоУрока = Время{8:30}
    пер КонецУрока = НачалоУрока + 45м
    Консоль.Записать(НачалоУрока.Представление("'Задача 1.\нУроки начинаются в 'ЧЧ:мм"))
    Консоль.Записать(КонецУрока.Представление("'Уроки заканчиваются в 'ЧЧ:мм\н"))
    
    //Задача 2
    пер СегодняшняяДата = Дата{2025-09-01}
    пер ДРДруга = СегодняшняяДата.ДобавитьДни(100)
    Консоль.Записать(ДРДруга.Представление("'Задача 2.'\ндд ММММ гггг' - день рождения друга'\н"))
    
    //Задача 3.
    пер НачалоПутешествия = ДатаВремя{2025-07-15 10:30}
    пер КонецПутешествия = ДатаВремя{2025-08-05 18:45}
    пер ДлительностьПутешествия = КонецПутешествия - НачалоПутешествия
    Консоль.Записать("Задача 3.\нПутешествие длилось ${ДлительностьПутешествия.Дни} день, ${ДлительностьПутешествия.Часы} часов, ${ДлительностьПутешествия.Минуты} минут\н")
    
    //Задача 4.
    Консоль.Записать("Задача 4.")
    пер Встреча = Дата{2025-05-20}
    если Встреча.ДеньНедели() == ДеньНедели.Суббота или Встреча.ДеньНедели() == ДеньНедели.Воскресенье
        Консоль.Записать("Выходной")
    иначе
        Консоль.Записать(Встреча.ДеньНедели().Представление())
    ;
    
    //Задача 5.
    пер ВремяМосквы = ДатаВремя{2026-04-10 14:00}
    пер АбсолютноеВремя = ВремяМосквы.ВМомент(ЧасовойПояс{+3})
    пер ВремяКрасноярска = АбсолютноеВремя.ВДатаВремя(ЧасовойПояс{+7})
    Консоль.Записать(ВремяКрасноярска.Представление("'\нЗадача 5.\нОлимпиада начнется в Красноярске в 'ЧЧ:мм дд.ММ.гггг"))
    
    //Задача 6.
    пер Событие1 = ДатаВремя{2025-12-25 10:00}
    пер Событие2 = ДатаВремя{2025-12-25 15:30}
    если Событие1.Дата == Событие2.Дата
        Консоль.Записать("События в один день")
        если Событие1.Время == Событие2.Время
            Консоль.Записать("И в одно время!")
        иначе
            Консоль.Записать("Но в разное время")
        ;
    иначе
        Консоль.Записать("События в разное время и/или в разные дни")
    ;
    /*Даны два события: Событие1 – 25 декабря 2025 года в 10:00, Событие2 – 25 декабря 2025 
года в 15:30. Используя свойства Дата и Время типа ДатаВремя, проверьте, происходят ли 
события в один и тот же день, и в одно и то же время. Выведите сообщение: «События в 
один день, но в разное время» или «События в разное время и/или в разные дни».  */
    
;