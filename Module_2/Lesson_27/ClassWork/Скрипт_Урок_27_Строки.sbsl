    пер НомерДокумента = "Договор_003_001"
    пер ИндексРазделителя = НомерДокумента.НайтиСКонца("_")
    пер НовыйНомерДокумента = НомерДокумента.Заменить("_", "*") //заменяет все подходящие символы
    Консоль.Записать(ИндексРазделителя)
    Консоль.Записать(НовыйНомерДокумента)
    
