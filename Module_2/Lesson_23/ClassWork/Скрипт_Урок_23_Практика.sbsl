метод Скрипт()
    пер ПерваяКнига = новый Книга("Война и мир", "Л.Н.Толстой", 1990, 1621)
    пер ВтораяКнига = новый Книга("Бородино", "М.Ю.Лермонтов")
    
    Консоль.Записать(ПерваяКнига)
    Консоль.Записать(ВтораяКнига)
;