//=============
//= Структура =
//=============

структура Товар
    //поля - св-ва объекта, "простые переменные"
    обз знч Наименование: Строка
    //обз - обязательно (при заполнении карточки товара)
    пер Артикул: Строка
    пер Цена: Число
    
    метод УвеличитьЦену(Процент: Число) //метод структуры, работает только с существующим объектом
        Цена += Цена / 100 * Процент
    ;
    
    метод УменьшитьЦену(Процент: Число)
        Цена -= Цена / 100 * Процент
    ;
    
    статический метод ИзФайла(Путь: Строка): Массив<Товар>
        пер Строки: Массив<Товар>
        исп ПотокЧтения = новый Файл(Путь).ОткрытьПотокЧтения() //исп удаляет все данные из кеша после использования
        знч ЧтениеДанных = новый ЧтениеДанных(ПотокЧтения)
        пока не ЧтениеДанных.ЧтениеЗавершено()
            знч Строка = ЧтениеДанных.ПрочитатьСтроку()
            знч Части = Строка.Разделить(";") //считываем разделитель в файле
            Строки.Добавить(новый Товар(Части[0], Части[1], новый Число(Части[2])))
        ;
        возврат Строки
    ;
;


//================
//= Перечисление =
//================

перечисление ВидСообщения
    Важное,
    Обычное умолчание,
    Второстепенное
;
структура Сообщение
    обз пер Адресат: Строка
    пер Текст: Строка
    пер Важность: ВидСообщения
;
перечисление РекомендуемыеЦвета
    Красный,
    Зеленый,
    Синий    
    
    метод RGB(): АбсолютныйЦвет //метод перечисления
        пер АбсолютныйЦвет = новый АбсолютныйЦвет(0, 0, 0)
        выбор этот //этот- эл. перечисления, для которого вызывается метод
        когда Красный
            АбсолютныйЦвет = новый АбсолютныйЦвет(255, 0, 0)
        когда Зеленый
            АбсолютныйЦвет = новый АбсолютныйЦвет(0, 255, 0)
        когда Синий
            АбсолютныйЦвет = новый АбсолютныйЦвет(0, 0, 255)
        ;
        
        возврат АбсолютныйЦвет
    ;
    
    //Статические методы
    
;

метод Скрипт()
    //обращения к структуре
    пер ПервыйТовар = новый Товар("Холодильник", "М50", 39990) 
    //"Наименование" - св-во, "Холодильник" - значение
    пер ВторойТовар = новый Товар("Пылесос")
    ВторойТовар.Артикул = "Samsung VC200"
    ВторойТовар.Цена = 5990
    ПервыйТовар.УвеличитьЦену(20)
    ВторойТовар.УменьшитьЦену(20)
    
    пер СписокТоваров = Товар.ИзФайла("Товары.txt")
    для НовыйТовар из СписокТоваров
        Консоль.Записать(НовыйТовар)
    ;
    
    
    //обращения к перечислению
    пер НовоеСообщение = новый Сообщение("Директор", "Отчет", ВидСообщения.Важное)
    пер ВтороеСообщение = новый Сообщение("Бухгалтер", "Отчет")
    пер ТретьеСообщение = новый Сообщение("Менеджер", "Отчет", ВидСообщения.Второстепенное)

    пер  МойКрасный  = РекомендуемыеЦвета.Красный
    пер  RGB = МойКрасный.RGB() 
    
;