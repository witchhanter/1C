метод Четное(Число: Число): Строка
    пер Четность: Булево
    если Число % 2 == 0
        Четность = Истина
    иначе
        Четность = Ложь
    ;
    возврат Четность.Представление()
;
// метод ВремяВПути(Расстояние: Число, Скорость: Число): Число
//     пер ВремяВМинутах = Расстояние / Скорость * 60
//     возврат ВремяВМинутах
