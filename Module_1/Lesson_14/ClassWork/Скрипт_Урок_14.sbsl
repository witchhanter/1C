//Задание 1
метод Гостиная()
    пер Предмет = "Диван"
    Консоль.Записать(Предмет)
;
метод Кухня()
    пер Предмет = "Стол"
    Консоль.Записать(Предмет)
;

//Задание 2
метод Счетчик(Количество: Число): Число
    Количество += 1
    возврат Количество
;

//Задание 3
метод Приветствие(Имя: Строка): Строка
    Имя = "Аноним"
    возврат "Привет, " + Имя
;

//Задание 4
метод ОпределитьСтатус(Возраст: Число)
    пер Статус = Возраст >= 18 ? "Взрослый":"Ребёнок"
    Консоль.Записать(Статус)
;

//Задание 5 ?
//Задание 6 ?

//Задание 7
метод Квадрат(Число: Число): Число
    Число = Число ** 2
    возврат Число
;

//Задание 8
метод ВывестиКвадраты()
    пер СуммаКвадратов: Число
    пер Квадрат: Число
    для i = 1 по 5
        Квадрат = i * i
        СуммаКвадратов += Квадрат
        Консоль.Записать(Квадрат)
    ;
    Консоль.Записать("Сумма квадратов: %СуммаКвадратов")
    Консоль.Записать(Квадрат)
;

//Задание 9
метод МетодА()
    пер Значение = 10
;
метод МетодБ()
    пер Значение = 20
;
