//Задание 4
метод ОпределитьСтатус(Возраст: Число)
    пер Статус = Возраст >= 18 ? "Взрослый":"Ребёнок"
    Консоль.Записать(Статус)
;

//Задание 1
метод Приветствие(Имя: Строка)
    Консоль.Записать("Привет, %Имя!")
;
метод РасчетВремени(ДатаЭкзамена: Дата): Число
    пер ДнейДоЭкзамена: Длительность
    пер Сегодня = Дата.Сейчас()
    ДнейДоЭкзамена = (ДатаЭкзамена - Сегодня)
    возврат ДнейДоЭкзамена.Дни
;
метод ПроверкаПогоды(Температура: Число): Строка
    пер Погода: Строка
    пер Рекомендация: Строка
    выбор Температура
    когда > 10
        Погода = "Очень тепло."
        Рекомендация = "Идти пешком."
    когда <= -10
        Погода = "Очень холодно."
        Рекомендация = "Остаться дома."
    когда < 0
        Погода = "Холодно."
        Рекомендация = "Ехать на машине."
    иначе 
        Погода = "Тепло." 
        Рекомендация = "Ехать на автобусе."
    ;
    возврат "%Погода\н%Рекомендация"
;

//Задание 10
метод СколькоВремени(Час: Число): Строка
    пер ВремяСуток: Строка
    если Час > 5 и Час < 12
        ВремяСуток = "Утро"
    иначе если Час > 11 и Час < 18
        ВремяСуток = "День"
    иначе если Час > 17 и Час < 23
        ВремяСуток = "Вечер"
    иначе если Час > 22 и Час < 6
        ВремяСуток = "Ночь"
    иначе
        ВремяСуток = "Введите корректное время суток!"
    ;
    
    возврат "> %ВремяСуток"  
;













