метод Скрипт()
    // 7,8,9
    пер СРскорость = 5
    пер СРскорНаВело = 15
    пер РасстояниеДоШколы = 6
    пер ВремяДоШколы = РасстояниеДоШколы / СРскорость
    пер ВремяДоШколыНаВело = РасстояниеДоШколы / СРскорНаВело
    пер ВремяВСутках = 24
    пер СветлоеВрВСутках = 13
    пер КвоПешком = ВремяВСутках / ВремяДоШколы
    пер КвоНаВело = СветлоеВрВСутках / ВремяДоШколыНаВело
    // 10
    пер ВПортфеле = 0
    пер ВзялИзДома = 2
    // ВПортфеле = ВзялИзДома + ВзялИзДома + 2 + ВзялИзДома + 2 + 2

    пер КвоДней = 0
    пока КвоДней != 3
        ВПортфеле += (ВзялИзДома + КвоДней * 2)
        КвоДней += 1
    ;
;