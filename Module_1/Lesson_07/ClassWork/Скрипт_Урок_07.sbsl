метод Скрипт()
    //облачая среда
    // пер Зона: ЧасовойПояс = ЧасовойПояс{UTC+3}
    // пер ТекущееВремя = ДатаВремя.Сейчас(Зона)
    
    // пер ТекущееВремя = ДатаВремя.Сейчас()
    
    // пер Завтра = ДатаВремя{2026-02-20 9:00:10}
    
    // пер Вчера = новый ДатаВремя(2026, 02, 18, 15, 00, 01, 01)
    
    // пер Сегодня = Вчера + 1д
    // Сегодня = Завтра.ДобавитьДни(-1)
    
    
    
    
    
    //Задание 1
    Консоль.Записать("Задание 1")
    пер КаникулыЛитерал = ДатаВремя{2025-12-30}
    пер КаникулыКонструктор = новый ДатаВремя(2025, 12, 30)
    Консоль.Записать(КаникулыЛитерал)
    Консоль.Записать(КаникулыКонструктор)
    
    //Задание 2
    Консоль.Записать("Задание 2")
    пер МойДеньРождения = новый ДатаВремя(2009, 04, 18)
    пер Сейчас = ДатаВремя.Сейчас()
    пер ВозрастВСекундах = Сейчас - МойДеньРождения
    Консоль.Записать(ВозрастВСекундах.ВСекундах())
    
    //Задание 3
    Консоль.Записать("Задание 3")
    пер Отправление = ДатаВремя{2025-06-25 23:50:00}
    пер ВремяВПути = 14ч30м
    пер Прибытие = Отправление + ВремяВПути
    Консоль.Записать(Прибытие)
    
    //Задание 4
    Консоль.Записать("Задание 4")
    пер НачалоДня = ДатаВремя.Сейчас().НачалоДня()
    пер НачалоТренировки = НачалоДня + 16ч30м
    пер Длительность = 1ч45м
    пер КонецТренировки = НачалоТренировки + Длительность
    Консоль.Записать("Тренировка закончится в " + КонецТренировки.Время.Представление())
    
    //Задание 5
    Консоль.Записать("Задание 5")
    пер РублейЗаДень = 50
    пер Старт = ДатаВремя{2025-09-01}
    пер Финиш = ДатаВремя{2025-12-31}
    пер КвоДнейМежду = (Финиш - Старт).ВДнях()
    пер ДенегНакопится = КвоДнейМежду * РублейЗаДень
    Консоль.Записать("За " + КвоДнейМежду + " дней накоплено " + ДенегНакопится + " рублей")
    
    //Задание 6
    Консоль.Записать("Задание 6")
    пер ДатаИзготовления = новый ДатаВремя(2025, 10, 10, 8, 30, 00)
    пер СрокГодности = 14д
    пер ГоденДо = (ДатаИзготовления + СрокГодности).КонецДня()
    пер ДатаОбеда = ДатаВремя{2025-10-20 12:00}
    Консоль.Записать((ГоденДо - ДатаОбеда).ВЧасах())
    
    //Задание 7
    Консоль.Записать("Задание 7")
    пер ДеньРождения2026 = ДатаВремя{2026-04-18 00:00}
    пер ДеньНедели = ДеньРождения2026.ДеньНедели()
    Консоль.Записать(ДеньНедели)
    
    //Задание 8
    Консоль.Записать("Задание 8")
    пер Вылет = ДатаВремя{2025-07-05 11:20}
    пер ВремяВПолете = 9ч50м
    пер ВремяПрилетаМ = Вылет + ВремяВПолете
    пер ВремяПрилетаН = ВремяПрилетаМ - 7ч
    Консоль.Записать(ВремяПрилетаМ + "\н" + ВремяПрилетаН)
    
    //Задание 9
    // Консоль.Записать("Задание 9")
    // пер Занятие = ДатаВремя{2025-10-15 15:00}
    // пер ДеньИсходнойДаты = Занятие.ДеньНедели()
    // пер Сдвиг = ДеньИсходнойДаты.Индекс - ДеньНедели.Понедельник.Индекс
    // пер НовоеЗанятие = Занятие - 2д
    
    //Задание 10
    Консоль.Записать("Задание 10")
    пер НовыйГод = ДатаВремя{2027-01-01 00:00}
    пер ДатаПокупок = НовыйГод - 3д
    пер ДатаЕлки = НовыйГод - 1д
    пер СегодняУтром = ДатаВремя.Сейчас().НачалоДня()
    пер ОстатокДней = (НовыйГод - СегодняУтром).ВДнях()
    Консоль.Записать(
    "Дата нового года: " + НовыйГод + "\н" + 
    "Дата покупок: " + ДатаПокупок + "\н" + 
    "Остаток дней до нового года: " + ОстатокДней
    )
;