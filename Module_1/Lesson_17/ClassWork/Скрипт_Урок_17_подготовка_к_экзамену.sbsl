метод Скрипт()
    
    //Подготовка к итоговой аттестации по 1 модулю
    Консоль.Записать("==== Подготовка к итоговой аттестации по 1 модулю ====\н")
    
    
//=============
//= Вариант 1 =
//=============
    Консоль.Записать("\н=============\н= Вариант 1 =\н=============\н")
    
    //Задание 1
    // Консоль.Записать("> Привет! Меня зовут " + Консоль.СчитатьСтроку("Задание 1.\нВведите Ваше имя: "))
    Консоль.Записать("Задание 1.\н> Привет! Меня зовут Игорь.\н")
    
    //Задание 2
    пер Возраст = 13
    Возраст = 14
    Консоль.Записать("Задание 2.\н> Возраст: %Возраст\н")
    
    //Задание 3
    пер Сумма: Число
    для Сложение = 100 по 5000
        Сумма += Сложение
    ;
    Консоль.Записать("Задание 3.\н> Сумма чисел от 100 до 5000: %Сумма\н")
    
    //Задание 4
    пер Текст1 = "Я люблю программировать и бутерброды"
    Консоль.Записать("Задание 4.\нТекст: %Текст1")
    пер КоличествоПробелов1: Число
    // КоличествоПробелов = Текст.КоличествоВхождений(" ")
    для Вхождение из Текст1
        если Вхождение == " "
            КоличествоПробелов1 += 1
        ;
    ;
    Консоль.Записать("> Количество пробелов в тексте: %КоличествоПробелов1\н")
    
    
//=============
//= Вариант 2 =
//=============
    Консоль.Записать("\н=============\н= Вариант 2 =\н=============\н")
    
    //Задание 1
    // Консоль.Записать("> Привет! Меня зовут " + Консоль.СчитатьСтроку("Задание 1.\нВведите Ваше имя: "))
    Консоль.Записать("Задание 1.\н> Привет! Меня зовут Игорь.\н")
    
    //Задание 2
    пер СкоростьВаси = 5
    пер Расстояние = 6
    пер ВремяВМинутах = Расстояние / СкоростьВаси * 60
    Консоль.Записать("Задание 2.\н> Вася дойдёт до школы за %ВремяВМинутах минуты\н")
    
    //Задание 3
    пер НачалоКурса = новый ДатаВремя(2025, 12, 31, 0, 0, 0)
    Консоль.Записать("Задание 3.\н" + НачалоКурса.Дата.Представление())
    НачалоКурса += 23д
    Консоль.Записать(НачалоКурса.Дата.Представление())
    
    //Задание 4
    пер Текст2 = "Программирование на 1С вызывает у меня безумный интерес"
    Консоль.Записать("\нЗадание 4.\нТекст: %Текст2")
    пер КоличествоПробелов2: Число
    для Вхождение из Текст2
        если Вхождение == " "
            КоличествоПробелов2 += 1
        ;
    ;
    Консоль.Записать("> Количество пробелов в тексте: %КоличествоПробелов2\н")
    
    
//=============
//= Вариант 3 =
//=============
    Консоль.Записать("\н=============\н= Вариант 3 =\н=============\н")
    
    //Задание 1
    // Консоль.Записать("> Привет! Меня зовут " + Консоль.СчитатьСтроку("Задание 1.\нВведите Ваше имя: "))
    Консоль.Записать("Задание 1.\н> Привет! Меня зовут Игорь.\н")
    
    //Задание 2
    пер Сумма2: Число
    для Сложение = 1 по 10
        Сумма2 += Сложение
    ;
    Консоль.Записать("Задание 2.\н> Сумма чисел от 1 до 10: %Сумма2\н")
    
    //Задание 3
    пер НазваниеПредмета = "Информатика"
    пер КоличествоБаллов = 100
    пер Результат = "Ученик набрал по предмету %НазваниеПредмета %КоличествоБаллов баллов."
    Консоль.Записать("Задание 3.\н> %Результат\н")
    
    //Задание 4
    пер Текст3 = "Сегодня на занятии мы не только изучали теорию, но и практиковались!"
    Консоль.Записать("Задание 4.\нТекст: %Текст3")
    пер КоличествоПробелов3: Число
    для Вхождение из Текст3
        если Вхождение == " "
            КоличествоПробелов3 += 1
        ;
    ;
    Консоль.Записать("> Количество пробелов в тексте: %КоличествоПробелов3")
;