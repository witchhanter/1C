// =============================
// ======= Ерофеев Игорь =======
// =============================
метод Скрипт()
    
    //=============
    //== Срез1_1 ==
    //=============
    Консоль.Записать("\н === Срез1_1 === \н")


    //Задание 1
    Консоль.Записать("Задание 1. \н" + "Привет!")

    //Задание 2
    пер Возраст = 13
    Возраст = 14
    Консоль.Записать("Задание 2. \н" + Возраст)

    //Задание 3
    пер СкоростьВаси = 5
    пер Расстояние = 6
    Консоль.Записать("Задание 3. \н" + Расстояние / СкоростьВаси * 60)

    //Задание 4
    пер НачалоКурса = новый ДатаВремя(2025, 12, 31)
    Консоль.Записать("Задание 4. \н" + НачалоКурса.ДобавитьДни(3 * 7 + 2))

    //Задание 5
    пер Число = Консоль.СчитатьЧисло("Задание 5. \нВведите число, которое необходимо проверить на четность: ")
    пер Четность = Число % 2 == 0 ? " Введенное число четное." : "Введенное число нечетное."
    Консоль.Записать(Четность)

    //Задание 6
    пер НазваниеПредмета = "Информатика"
    пер КоличествоБаллов = 5
    пер Результат = "Ученик набрал по предмету %НазваниеПредмета %КоличествоБаллов баллов."
    Консоль.Записать("Задание 6. \н" + Результат)

    //Задание 7
    пер ЦенаПирожка = 75
    пер ЦенаСока = 60
    пер МоиДеньги = 150
    пер ХватитЛи = МоиДеньги - (ЦенаПирожка + ЦенаСока) >= 0 ? "Истина" : "Ложь"
    Консоль.Записать("Задание 7. \н" + ХватитЛи)


    //=============
    //== Срез1_2 ==
    //=============
    Консоль.Записать("\н === Срез1_2 === \н")

    //Задание 1
    Консоль.Записать("Задание 1. \нПривет, мир!")

    //Задание 2
    пер ДенегУПети = 200
    пер ЦенаШоколадки = 85
    пер ЦенаПеченья = 67
    пер ОстатокДенег = ДенегУПети - ЦенаШоколадки - ЦенаПеченья
    Консоль.Записать("Задание 2. \н" + "У Пети осталось " + ОстатокДенег + " рублей")
    
    //Задание 3
    СкоростьВаси = 12
    Расстояние = 18
    Консоль.Записать("Задание 3. \н" + Расстояние / СкоростьВаси * 60)
    
    //Задание 4
    пер НачалоМиграции = новый ДатаВремя(2025, 3, 24,19,46,00)
    НачалоМиграции = НачалоМиграции.ДобавитьДни(3)
    пер ДлинаМиграции = 32ч
    пер Завершение = НачалоМиграции + ДлинаМиграции
    пер КонецДня = Завершение.КонецДня()
    пер МинутДоКонцаДня = (КонецДня - Завершение)
    Консоль.Записать(
    "Задание 4. \н" 
    + МинутДоКонцаДня.ВМинутах() 
    + " минут останется от момента завершения переноса до конца этого же дня"
    )

    //Задание 5
    пер Число_2 = 37
    пер Четность_2 = 37 % 2 == 0 ? "чётное":"нечётное"
    Консоль.Записать("Задание 5. \н" + Четность_2)
    
    //Задание 6
    пер Город = "Петрозаводск"
    пер Население = 300000
    Консоль.Записать("Задание 6. \нВ городе %Город проживает %Население человек.")
    
    //Задание 7
    пер ЦенаКниги = 380
    пер ЦенаБлокнота = 150
    пер ДенегУВас = 500
    пер ХватитЛи_2 = ДенегУВас - ЦенаКниги - ЦенаБлокнота >= ДенегУВас ? "Истина":"Ложь"
    Консоль.Записать("Задание 7. \н%ХватитЛи_2")
    
    
    //=============
    //== Срез1_3 ==
    //=============
    Консоль.Записать("\н === Срез1_3 === \н")
    
    //Задание 1
    Консоль.Записать("Задание 1. \нДобрый день!")
    
    //Задание 2
    пер ЯблокУМаши = 5
    пер ЕлаВДень = 2
    пер ЧерезДня = 2
    Консоль.Записать("Задание 2. \н" + (ЯблокУМаши - ЕлаВДень * ЧерезДня))
    
    //Задание 3
    пер СкоростьСамолета = 900
    пер РасстояниеОтМдоС = 1350
    пер ВремяПолета = РасстояниеОтМдоС / СкоростьСамолета
    Консоль.Записать("Задание 3. \н%ВремяПолета")
    
    //Задание 4
    пер НачалоАкции = ДатаВремя{2025-12-31 11:00:00} 
    пер ДлительностьАкции = 7д
    пер ДатаОкончания = НачалоАкции + ДлительностьАкции - 1д12ч
    пер ПоловинаДлительности = ((ДатаОкончания - НачалоАкции) / 2).ВМинутах()
    Консоль.Записать("Задание 4. \н%ПоловинаДлительности")
    
    //Задание 5
    Число = 42
    пер Равность = Число == 42 ? "равны":"не равны"
    Консоль.Записать("Задание 5. \н%Равность")
    
    //Задание 6
    пер МойВозраст = 16
    пер МоеХобби = "программирование"
    Консоль.Записать("Задание 6. \нМне %МойВозраст лет, я увлекаюсь %МоеХобби.")
    
    //Задание 7
    пер ВозрастРебенка = 10
    пер ОграничениеВозраста = 12
    пер Результат_2 = ВозрастРебенка >= ОграничениеВозраста ? "Истина":"Ложь"
    Консоль.Записать("Задание 7. \н%Результат_2")
    
    
    
    //=============
    //== Срез1_4 ==
    //=============
    Консоль.Записать("\н === Срез1_4 === \н")
    
    //Задание 1
    Консоль.Записать("Задание 1. \нСегодня отличный день для программирования!")
    
    //Задание 2
    пер ДенегУВаси = 150
    пер ЦенаМороженного = 60
    пер Нашел = 20
    Консоль.Записать("Задание 2. " + (ДенегУВаси - ЦенаМороженного + Нашел))
    
    //Задание 3
    
;
