метод Скрипт()
    // пер МоеИмя = "Игорь"
    // пер НеМоеИмя: Строка
    // НеМоеИмя = "Иван"
    // пер МоеЧисло = 32
    // МоеЧисло *= 2
    // МоеЧисло = МоеЧисло ** 2
    // МоеЧисло = МоеЧисло % 100
    // МоеЧисло = МоеЧисло / 10
    //№11
    пер ДлинаУрока = 45
    пер ДлинаПеремены = 15
    пер ДлинаБольшойПеремены = 25
    пер ВсегоУроков = 6
    пер ВремяВШколе = ДлинаУрока * ВсегоУроков + ДлинаПеремены * (ВсегоУроков - 2) + ДлинаБольшойПеремены
    //№12
    пер СтупениПередВходом = 3
    пер СтупениВМарше = 10
    пер Этаж = 6
    пер Ступени: Число
    если Этаж == 1 или Этаж == 2
        Ступени = 3 + СтупениВМарше
    иначе
        Ступени = СтупениПередВходом + СтупениВМарше * 2 * Этаж
    ;
    //№1
    пер СкоростьПоезда = 60
    пер Расстояние = 45
    пер ВремяВПути = Расстояние/СкоростьПоезда*60
    //№2
    пер ДенегВКопилке = 1500
    пер ЦенаПодарка = 3500
    пер ОсталосьНакопить = ЦенаПодарка - ДенегВКопилке
    //№3
    пер ВодыНаСтакан = 200
    пер КоличествоСтаканов = 8
    пер ВсегоВоды = КоличествоСтаканов * ВодыНаСтакан / 1000
    //№4
    пер ДлинаБассейна = 25
    пер КоличествоБассейнов = 20
    пер Дистанция = ДлинаБассейна * КоличествоБассейнов / 1000
    //№5
    пер Цена = 5000
    пер СкидкаВПроцентах = 15
    пер ИтоговаяЦена = Цена * (1 - СкидкаВПроцентах / 100)
    //№6
    пер РасстояниеНаКарте = 7.5
    пер РеальноеРасстояние = РасстояниеНаКарте
    //№7
    пер Емкость = 10000
    пер Ток = 2000
    пер ВремяЗарядки = Емкость / Ток
    //№8
    пер На1КвМ = 5 //л
    пер ПлощадьГрядки = 12.5 // м^2
    пер НужноВоды = ПлощадьГрядки  * На1КвМ
    //№9
    пер РазмерФайла = 2.5 //гб
    пер СкоростьИнтернета = 50 //мбит/с
    пер ВремяЗагрузки = РазмерФайла * 1024 * 8 / СкоростьИнтернета
    //№10
    пер ДлинаПлитки = 0.3 //м
    пер ШиринаПлитки = 0.2 //м
    пер ПлощадьСтен = 4.5 //м^2
    пер НужноПлиток = ПлощадьСтен / ДлинаПлитки / ШиринаПлитки
    
    
    
;