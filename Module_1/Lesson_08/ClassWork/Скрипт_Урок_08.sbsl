метод Скрипт()
    // пер Равенство = 5 == 5
    // пер Неравенство = 5 != 5
    // пер СтрогоБольше = 5 > 5
    // пер СтрогоМеньше = 5 < 5
    // пер БольшеРавно = 5 >= 5
    // пер МеньшеРавно = 5 <= 10
    
    // пер Оценка = 4
    // пер Стипендия = Оценка >= 4 ? 3500:0
    
    // пер ОстатокТоваров = 10
    // пер Заказ = ОстатокТоваров < 5 ? "Требуется":"Не требуется"
    
    //Задание 19
    // пер НачалоЗанятий = 8ч30м
    // пер КонецЗанятий = 15ч25м
    // пер ОбычноеВремяВШколе = КонецЗанятий - НачалоЗанятий
    // пер Сегодня = Дата.Сейчас().ДеньНедели()
    // пер Среда = (Дата.Сейчас() + 4д).ДеньНедели()
    // пер ВремяВШколе = Сегодня == ДеньНедели.Среда ? ОбычноеВремяВШколе + 2ч:ОбычноеВремяВШколе
    
    //Задание 6
    // пер Сумма = 850
    // пер Скидка = Сумма > 1000 ? Сумма * 0.85 : Сумма * 0.95
    
    //Задание 20
    // пер ЯИдуНаРаботу = Истина
    // пер ИдетДождь = Истина
    // пер НадоВзятьЗонт = ЯИдуНаРаботу и ИдетДождь
    // Консоль.Записать(НадоВзятьЗонт)
    
    //Задание 21
    пер СегодняВыходной21 = Истина
    пер ЯБолею = Истина
    пер ЯНеИдуВШколу = СегодняВыходной21 или ЯБолею
    Консоль.Записать("Задание 21: %ЯНеИдуВШколу")
    
    //Задание 22
    пер ХорошаяПогода = Истина
    пер СегодняВыходной22 = Истина
    пер СегодняПраздник = Истина
    пер ЯИдуГулять = ХорошаяПогода и (СегодняВыходной22 или СегодняПраздник)
    Консоль.Записать("Задание 22: %ЯИдуГулять")
    
    //Задание 23
    пер СегодняСуббота = Истина
    пер СегодняВоскресенье = Истина
    пер ЯИдуНаРаботу = не (СегодняСуббота и СегодняСуббота)
    Консоль.Записать("Задание 23: %ЯИдуНаРаботу")
    
    //Задание 24
    пер НомерДняНедели = Консоль.СчитатьЧисло("Задание 24: Введите номер дня недели (1-7): ")
    пер ВремяДляИгры: Число
    если НомерДняНедели < 8 и НомерДняНедели > 0
        если НомерДняНедели <= 5
            ВремяДляИгры = 1
        иначе
            ВремяДляИгры = 4
        ;
        Консоль.Записать("Время для игры в выбранный день: %ВремяДляИгры")
    иначе
        Консоль.Записать("Номер дня недели должне быть в промежутке от 1 до 7!")
    ;
    
    
    
    
    
    //Задание 8
    пер ТвойВозраст = 10
    пер Ограничение = 12
    пер Можно = ТвойВозраст >= 12 ? "Можно":"Нельзя"
    
    //Задание 9
    пер ДеньгиОтБабушки = 2000
    пер ЦенаПодарка = 2500
    пер Действие = ДеньгиОтБабушки > ЦенаПодарка ? "Копить":"Покупать"
;

