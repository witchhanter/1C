// =============================
// ======= Ерофеев Игорь =======
// =============================
метод Скрипт()
    
    //=============
    //== Срез2_1 ==
    //= Вариант 1 =
    //=============
    
    //Задание 1
    пер Час = 18
    пер ВремяСуток: Строка
    если Час > 5 и Час < 12
        ВремяСуток = "Утро"
    иначе если Час > 11 и Час < 18
        ВремяСуток = "День"
    иначе если Час > 17 и Час < 23
        ВремяСуток = "Вечер"
    иначе
        ВремяСуток = "Ночь"
    ;
    Консоль.Записать("Задание 1. «Утро, день, вечер»\н> Время суток: %ВремяСуток")
    
    //Задание 2
    Консоль.Записать("\нЗадание 2. «Таблица умножения на 5»")
    пер Число = 5
    для Умножение = 1 по 10
        Консоль.Записать("%Число * %Умножение = " + Число * Умножение)
    ;
    
    //Задание 3
    пер НомерМесяца = 4
    пер Дней: Строка
    выбор НомерМесяца
    когда 2 
        Дней = "28"
    когда 4, 6, 9, 11
        Дней = "30"
    когда 1, 3, 5, 7, 8, 10, 12
        Дней = "31"
    иначе
        Дней = "Ошибка! Неверный номер месяца."
    ;
    Консоль.Записать("\нЗадание 3. «Количество дней в месяце»\н> В %НомерМесяца месяце %Дней дней\н")
    
    //Задание 4
    Приветствие("Игорь")
    
    //Задание 5
    Консоль.Записать("Задание 5. «Стоимость поездки на такси»\н> Стоимость поездки: " + СтоимостьПоездки(12, 25) + " рублей\н")
    
    //Задание 6
    Консоль.Записать("Задание 6. «Сумма чисел от 1 до N».\н> Сумма чисел до числа: " + СуммаДо(10) + "\н")
    
    //Задание 7
    Консоль.Записать("Задание 7. «Расписание звонков»")
    для КонецУроков = 1 по Консоль.СчитатьЧисло("Введите количество уроков: ")
        // Консоль.Записать("Урок %КонецУроков заканчивается в " + ВремяОкончанияУрока(КонецУроков).Представление())
        
        // Консоль.Записать("Урок %КонецУроков заканчивается в " + ВремяОкончанияУрока(КонецУроков).Час + ":" + ВремяОкончанияУрока(КонецУроков).Минута)
        
        если ВремяОкончанияУрока(КонецУроков).Час.Представление().Длина() == 1
            Консоль.Записать("Урок %КонецУроков заканчивается в 0" + ВремяОкончанияУрока(КонецУроков).Час + ":" + ВремяОкончанияУрока(КонецУроков).Минута)
        иначе если ВремяОкончанияУрока(КонецУроков).Минута.Представление().Длина() == 1
            Консоль.Записать("Урок %КонецУроков заканчивается в " + ВремяОкончанияУрока(КонецУроков).Час + ":0" + ВремяОкончанияУрока(КонецУроков).Минута)
        иначе
            Консоль.Записать("Урок %КонецУроков заканчивается в " + ВремяОкончанияУрока(КонецУроков).Час + ":" + ВремяОкончанияУрока(КонецУроков).Минута)
        ;
        
    ;
;

//Задание 4
метод Приветствие(Имя: Строка)
    Консоль.Записать("Задание 4. «Приветствие по имени»\н> Привет, %Имя!\н")
;

//Задание 5
метод СтоимостьПоездки(Километры: Число, ЦенаЗаКм: Число): Число
    пер Стоимость = Километры * ЦенаЗаКм
    возврат Стоимость
;

//Задание 6
метод СуммаДо(N: Число): Число
    пер Сумма: Число
    для Суммирование = 1 по N
        Сумма += Суммирование
    ;
    возврат Сумма   
;

//Задание 7
метод ВремяОкончанияУрока(НомерУрока: Число): Время
    пер ВремяОкончания: Время
    пер НачалоУроков = 510
    пер ДлительностьУрока = 45
    пер Перемена = 10
    пер БольшаяПеремена = 20
    пер Конец: Время
    если НомерУрока > 3
        Конец = Конец.ДобавитьМинуты(НачалоУроков + ДлительностьУрока * НомерУрока + БольшаяПеремена + Перемена * (НомерУрока - 2))
        возврат Конец
    иначе
        Конец = Конец.ДобавитьМинуты(НачалоУроков + ДлительностьУрока * НомерУрока + Перемена * (НомерУрока - 1))
        возврат Конец
    ;
    
;
