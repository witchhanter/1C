метод Скрипт()
    
    // если
        
    // иначе если 
            
    // ;
    
    //Задание 20
    пер ЯИдуНаРаботу1 = Истина
    пер ИдетДождь = Истина
    пер НадоВзятьЗонт = ЯИдуНаРаботу1 и ИдетДождь
    Консоль.Записать("Задание 21: %НадоВзятьЗонт\н")
    
    //Задание 21
    пер СегодняВыходной21 = Истина
    пер ЯБолею = Истина
    пер ЯНеИдуВШколу = СегодняВыходной21 или ЯБолею
    Консоль.Записать("Задание 21: %ЯНеИдуВШколу\н")
    
    //Задание 22
    пер ХорошаяПогода = Истина
    пер СегодняВыходной22 = Истина
    пер СегодняПраздник = Истина
    пер ЯИдуГулять = ХорошаяПогода и (СегодняВыходной22 или СегодняПраздник)
    Консоль.Записать("Задание 22: %ЯИдуГулять\н")
    
    //Задание 23
    пер СегодняСуббота = Истина
    пер СегодняВоскресенье = Истина
    пер ЯИдуНаРаботу = не (СегодняСуббота и СегодняСуббота)
    Консоль.Записать("Задание 23: %ЯИдуНаРаботу\н")
    
    //Задание 24, 25
    // пер НомерДняНедели = Консоль.СчитатьЧисло("Задание 24: Введите номер дня недели (1-7): ")
    пер НомерДняНедели = 4
    пер ВремяДляИгры: Число
    если НомерДняНедели < 8 и НомерДняНедели > 0
        если НомерДняНедели <= 5
            ВремяДляИгры = 1
        иначе
            ВремяДляИгры = 4
        ;
        Консоль.Записать("Время для игры в выбранный день: %ВремяДляИгры\н")
    иначе
        Консоль.Записать("Номер дня недели должне быть в промежутке от 1 до 7!")
    ;
    
    //Задание 26
    
    пер НачалоРаботыМагазина = 9ч
    пер КонецРаботыМагазина = 20ч
    пер ТекущийЧас = 21ч
    
    Консоль.Записать("Задание 26.\н")
    Консоль.Записать("Время работы супермаркета: с %НачалоРаботыМагазина до %КонецРаботыМагазина")
    Консоль.Записать("Время сейчас: %ТекущийЧас")
    
    если НачалоРаботыМагазина < ТекущийЧас и ТекущийЧас < КонецРаботыМагазина
        Консоль.Записать("Супермаркет еще открыт, идем в него.")
        если Консоль.СчитатьБулево("Кефир есть? (Да/Нет) - ")
            Консоль.Записать("> Вы купили кефир.")
        иначе если Консоль.СчитатьБулево("Ряженка есть? (Да/Нет) - ")
            Консоль.Записать("> Вы купили ряженку.")  
        иначе если Консоль.СчитатьБулево("Молоко есть? (Да/Нет) - ")
            Консоль.Записать("> Вы купили молоко. ")  
        иначе
            Консоль.Записать("> Не повезло, сегодня без молочки.")
        ;
        
    иначе
        
        Консоль.Записать("Супермаркет уже закрыт, идем в круглосуточный магазин.")
        
        если Консоль.СчитатьБулево("Молоко есть? (Да/Нет) - ")
            Консоль.Записать("> Вы купили молоко. ")
        иначе
            Консоль.Записать("> Не повезло, сегодня без молочки.")
        ;
    ;
    
    
    
;