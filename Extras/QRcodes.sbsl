//Генерация QR по вводимым данным.
//Автор:
// ======= Ерофеев Игорь =======

конст РАЗМЕР_МАЛЫЙ = 128
конст РАЗМЕР_СРЕДНИЙ = 256
конст РАЗМЕР_БОЛЬШОЙ = 512

конст ПОРОГ_МАЛЫЙ = 20
конст ПОРОГ_СРЕДНИЙ = 50

метод Скрипт()
    пер РабочаяПапка = ПутьКРабочейПапке()
    Файлы.СоздатьКаталог(РабочаяПапка)
    
    пер ДанныеДляЗаписиВQR = Консоль.СчитатьСтроку("\нВведите данные для записи в QR: ")
    пока ДанныеДляЗаписиВQR.Пусто()
        Консоль.Записать("Данные для записи не введены! попробуйте снова.")
        ДанныеДляЗаписиВQR = Консоль.СчитатьСтроку("\нВведите данные для записи в QR: ")
    ;
    ЗаписатьQR(ДанныеДляЗаписиВQR, РабочаяПапка)
;

метод ЗаписатьQR(Данные: Строка, ПутьДоРабочейПапки: Строка)
    пер Номер = 1
    пер НовыйQR = новый Файл("$ПутьДоРабочейПапки/QR_$Номер.png")
    пока НовыйQR.Существует()
        Номер = Номер + 1
        НовыйQR = новый Файл("$ПутьДоРабочейПапки/QR_$Номер.png")
    ;
    пер QR_1 = СозданиеQR(Данные)
    исп ПотокЗаписи = НовыйQR.ОткрытьПотокЗаписи()
    ПотокЗаписи.Записать(QR_1.КодироватьТекст(Данные))
    если НовыйQR.Существует()
        Консоль.Записать("QR-код успешно создан по адресу \"$ПутьДоРабочейПапки/QR.png.\"")
    иначе
        Консоль.Записать("Ошибка создания QR-кода.")
    ;  
;

метод СозданиеQR(Данные: Строка): ГенераторQrКода
    если Данные.Длина() < ПОРОГ_МАЛЫЙ
        пер QR_1 = новый ГенераторQrКода(РАЗМЕР_МАЛЫЙ, РАЗМЕР_МАЛЫЙ, УровеньКоррекцииQrКода.Низкий, ФорматИзображения.Png, Ложь)
        возврат QR_1
    иначе если Данные.Длина() < ПОРОГ_СРЕДНИЙ
        пер QR_1 = новый ГенераторQrКода(РАЗМЕР_СРЕДНИЙ, РАЗМЕР_СРЕДНИЙ, УровеньКоррекцииQrКода.Средний, ФорматИзображения.Png, Ложь)
        возврат QR_1
    иначе
        пер QR_1 = новый ГенераторQrКода(РАЗМЕР_БОЛЬШОЙ, РАЗМЕР_БОЛЬШОЙ, УровеньКоррекцииQrКода.Высокий, ФорматИзображения.Png, Ложь)
        возврат QR_1
    ;
;

метод ПутьКРабочейПапке(): Строка
    пер ВыборЗаписи = Консоль.СчитатьЧисло("Введите число с клавиатуры для создания каталога с QR-кодами:\н1 - ввести путь \н2 - использовать автоматический путь (сохранить в загрузки).\н > ")
    пер МестоКаталога = "/"
    если ВыборЗаписи == 1
        МестоКаталога = Консоль.СчитатьСтроку("Введите путь: ")
    иначе
        МестоКаталога = "/home/${СредаИсполнения.ПолучитьПеременную("USER")}/Загрузки/_QR-codes"
        если СредаИсполнения.ПолучитьСвойство("os.name").Найти("Windows") != -1
            МестоКаталога = "C:\\Users\\${СредаИсполнения.ПолучитьПеременную("USERNAME")}\\Downloads"
        ;
    ;
    возврат МестоКаталога
;
